<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Concierge.Web.Client</RootNamespace>
    <Description>Browser-only WebAssembly bootstrap for Concierge.Web. The shared application pages run on InteractiveServer and are referenced by the server host. Future browser components must depend on browser-safe contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Do not reference the server-owned shared UI graph here: it includes
       SQLite and the Circle AI service runtime. Concierge.Web references and
       routes those pages directly. This bootstrap currently owns no pages. -->

</Project>
