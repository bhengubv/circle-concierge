<!DOCTYPE html>
<!-- Concierge asks the design language for its dark theme.
     CircleMetroUI ships light and dark and defaults to light at :root; this app has been
     one dark workspace since the redesign, and that is a decision it should state rather
     than inherit by accident. Without the attribute the chrome came up light. -->
<html lang="en" data-theme="dark" data-skin="circle">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="_content/Concierge.Shared.Components/concierge.css" />
    <link rel="stylesheet" href="@Assets["Concierge.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="_content/Concierge.Shared.Components/concierge-voice.js" defer></script>
    <script src="_content/Concierge.Shared.Components/concierge-thread.js" defer></script>
    <script src="_content/Concierge.Shared.Components/concierge-design.js" defer></script>
    <script src="_content/Concierge.Shared.Components/concierge-formfactor.js"></script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["sense.js"]"></script>
    <script src="@Assets["camera.js"]"></script>
</body>

</html>
