@*
    Web host router — same `@` prefix story as the MAUI host's Routes.razor.
    Without `@` the strings are passed literally and Router silently fails to
    discover any @page route outside this assembly.
*@
<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="@(new[] { typeof(Concierge.Shared.Components.ComponentAssemblyMarker).Assembly })"
        NotFoundPage="@typeof(Concierge.Shared.Components.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData"
                   DefaultLayout="@typeof(Concierge.Shared.Components.Layout.ShellLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
