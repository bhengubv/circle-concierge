<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Concierge bridge for AetherNet. Implements IMeshTransportService on top of AetherNet.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CircleAI 3.9.1 still requires the modular AetherNet 3.0 assemblies.
         Keep their runtime identities intact; bind this adapter to the unified 3.4 assembly explicitly. -->
    <PackageReference Include="AetherNet" Version="$(AetherNetPackageVersion)" Aliases="ConciergeAetherNet" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
