<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>Concierge</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!--
          NU1608 fires on the Microsoft.AspNetCore.Components.WebView.Maui /
          Microsoft.Maui.Controls combo because both pin different patch
          versions of Microsoft.Extensions.* transitively. Same suppression
          SDPKT and the rest of the Geek apps use.
        -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Concierge</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.concierge</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
        Android Release signing lives in /Directory.Build.props at the repo root —
        keystore at %USERPROFILE%\keystore\TheGeekAlias.keystore, password via the
        ANDROID_KEYSTORE_PASS env var, AAB output enforced. The old CONCIERGE_*
        env-var-based block was removed so contributors don't need a separate
        keystore setup for Concierge vs. the rest of the Geek apps (SDPKT, etc.).
    -->

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2196F3" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2196F3" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <!--
      The encoder, for the one head that cannot run a program.

      Every other head finds ffmpeg on disk and starts it. An APK carries no
      executables beside the app and Android refuses to run a binary out of the
      app's own data directory, so eight tools that read a media file and
      design_save were simply absent on the phone — the whole measured gap
      between the handheld and the desktop.

      This carries the same ffmpeg as a library called through JNI, for arm64-v8a
      and x86_64. The x86_64 half matters more than it looks: it is what lets the
      emulator prove this rather than only a handset.

      **The LGPL build, not the GPL one**, which is the difference between
      Full and FullGpl in this package's naming. The rest of this repository is
      held to MIT/Apache/BSD/OFL/PD; ffmpeg is LGPL-2.1+ and this is the closest
      it gets. It is also the first thing here that is *redistributed* rather
      than found on the machine — on a desktop ffmpeg is somebody else's install
      — so the licence text ships with it and About says so.

      About 31 MB per ABI, which is the price and is why it is Android-only.
    -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="FFmpegKit.Net.Full.Android" Version="8.1.2.5" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
      <ProjectReference Include="..\Concierge.Shared.Components\Concierge.Shared.Components.csproj" />
      <ProjectReference Include="..\Concierge.Ai\Concierge.Ai.csproj" />
      <ProjectReference Include="..\Concierge.Ai.Isolated\Concierge.Ai.Isolated.csproj" />

      <!--
        The model host is deliberately NOT a ProjectReference. A reference makes
        MSBuild build it for this project's target framework — net10.0-windows —
        which it neither has nor wants: it is a plain console app this one
        launches, not a library it links. CopyModelHost below builds it for its
        own framework and puts the output beside the app.
      -->
      <ProjectReference Include="..\Concierge.Chat.Cloud\Concierge.Chat.Cloud.csproj" />
      <ProjectReference Include="..\Concierge.Diagrams.Design\Concierge.Diagrams.Design.csproj" />
      <ProjectReference Include="..\Concierge.Mesh\Concierge.Mesh.csproj" />
      <ProjectReference Include="..\Concierge.Media\Concierge.Media.csproj" />
      <ProjectReference Include="..\Concierge.Media.Cloud\Concierge.Media.Cloud.csproj" />
    </ItemGroup>


  <!--
    Put the model host beside the app.

    It is a whole output directory rather than one file: the host carries its
    own runtimeconfig, its dependencies and the native inference libraries, and
    an exe copied without them starts and immediately dies. Into a subfolder so
    the two sets of dependencies cannot shadow each other — IsolatedRuntimeOptions
    looks in "ModelHost" for exactly this reason.
  -->
  <Target Name="CopyModelHost" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <!--
      TargetFramework is set explicitly and RuntimeIdentifier removed: an MSBuild
      task inherits this project's global properties, so without both the host is
      asked to build for net10.0-windows and win-x64, which it neither has nor
      wants.
    -->
    <MSBuild Projects="..\Concierge.Model.Host\Concierge.Model.Host.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;Platform;PlatformTarget;SelfContained;TargetFrameworks" />

    <ItemGroup>
      <ModelHostFiles Include="..\Concierge.Model.Host\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(ModelHostFiles)"
          DestinationFolder="$(OutDir)ModelHost\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ModelHostFiles)' != ''" />
  </Target>

</Project>
