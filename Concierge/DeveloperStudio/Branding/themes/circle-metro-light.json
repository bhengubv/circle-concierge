{
  "$schema": "vscode://schemas/color-theme",
  "name": "Circle Metro Light",
  "type": "light",
  "colors": {
    "foreground": "#14202C",
    "focusBorder": "#005EA8",
    "editor.background": "#F3F6FA",
    "editor.foreground": "#14202C",
    "editorLineNumber.foreground": "#5B6877",
    "editorCursor.foreground": "#005EA8",
    "editor.selectionBackground": "#B7DDFA",
    "sideBar.background": "#E8F5FF",
    "sideBar.foreground": "#14202C",
    "sideBar.border": "#A7CDED",
    "sideBarSectionHeader.background": "#DCEEFF",
    "sideBarSectionHeader.foreground": "#14202C",
    "activityBar.background": "#005EA8",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#DCEEFF",
    "activityBarBadge.background": "#FFFFFF",
    "activityBarBadge.foreground": "#00548F",
    "titleBar.activeBackground": "#005EA8",
    "titleBar.activeForeground": "#FFFFFF",
    "editorGroupHeader.tabsBackground": "#DCEEFF",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#14202C",
    "tab.activeBorderTop": "#005EA8",
    "tab.inactiveBackground": "#DCEEFF",
    "tab.inactiveForeground": "#475667",
    "statusBar.background": "#005EA8",
    "statusBar.foreground": "#FFFFFF",
    "input.background": "#FFFFFF",
    "input.foreground": "#14202C",
    "input.border": "#78899B",
    "inputOption.activeBorder": "#005EA8",
    "list.activeSelectionBackground": "#B7DDFA",
    "list.activeSelectionForeground": "#14202C",
    "list.focusBackground": "#DCEEFF",
    "list.hoverBackground": "#DCEEFF",
    "list.highlightForeground": "#00548F",
    "quickInput.background": "#FFFFFF",
    "quickInput.foreground": "#14202C",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#A7CDED",
    "panelTitle.activeBorder": "#005EA8",
    "badge.background": "#005EA8",
    "badge.foreground": "#FFFFFF",
    "button.background": "#005EA8",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#00548F",
    "panel.background": "#E8F5FF",
    "panel.border": "#A7CDED"
  },
  "tokenColors": [
    { "scope": ["keyword", "storage.type"], "settings": { "foreground": "#00548F" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#176B3A" } },
    { "scope": ["comment"], "settings": { "foreground": "#475667", "fontStyle": "italic" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#805300" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#005EA8" } }
  ]
}
