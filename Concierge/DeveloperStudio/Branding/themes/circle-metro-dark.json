{
  "$schema": "vscode://schemas/color-theme",
  "name": "Circle Metro Dark",
  "type": "dark",
  "colors": {
    "foreground": "#FFFFFF",
    "focusBorder": "#56B4FF",
    "editor.background": "#08111D",
    "editor.foreground": "#F3F6FA",
    "editorLineNumber.foreground": "#7C98B3",
    "editorCursor.foreground": "#00D7F1",
    "editor.selectionBackground": "#005EA899",
    "sideBar.background": "#10263D",
    "sideBar.foreground": "#FFFFFF",
    "sideBar.border": "#28608C",
    "sideBarSectionHeader.background": "#17344F",
    "sideBarSectionHeader.foreground": "#FFFFFF",
    "activityBar.background": "#005EA8",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#D0E6F5",
    "activityBarBadge.background": "#00D7F1",
    "activityBarBadge.foreground": "#08111D",
    "titleBar.activeBackground": "#005EA8",
    "titleBar.activeForeground": "#FFFFFF",
    "editorGroupHeader.tabsBackground": "#10263D",
    "tab.activeBackground": "#1D4566",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#00D7F1",
    "tab.inactiveBackground": "#10263D",
    "tab.inactiveForeground": "#D0E6F5",
    "statusBar.background": "#005EA8",
    "statusBar.foreground": "#FFFFFF",
    "input.background": "#17344F",
    "input.foreground": "#FFFFFF",
    "input.border": "#3F769E",
    "inputOption.activeBorder": "#00D7F1",
    "list.activeSelectionBackground": "#1D4566",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.focusBackground": "#1D4566",
    "list.hoverBackground": "#17344F",
    "list.highlightForeground": "#56B4FF",
    "quickInput.background": "#10263D",
    "quickInput.foreground": "#FFFFFF",
    "editorWidget.background": "#17344F",
    "editorWidget.border": "#3F769E",
    "panelTitle.activeBorder": "#00D7F1",
    "badge.background": "#0078C8",
    "badge.foreground": "#FFFFFF",
    "button.background": "#0078C8",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#005EA8",
    "panel.background": "#10263D",
    "panel.border": "#28608C"
  },
  "tokenColors": [
    { "scope": ["keyword", "storage.type"], "settings": { "foreground": "#56B4FF" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#A4E5D7" } },
    { "scope": ["comment"], "settings": { "foreground": "#8CA5BA", "fontStyle": "italic" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#FFE3A5" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#00D7F1" } }
  ]
}
