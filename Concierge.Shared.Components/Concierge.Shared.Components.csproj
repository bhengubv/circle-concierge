<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Concierge.Shared.Components</RootNamespace>
    <Description>Shared Razor components (pages, layout) used by both the MAUI BlazorWebView host and the Concierge.Web server host. Single source of truth so the two hosts stay at parity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <!-- Inline the shipped sprite: Android WebView can refuse external SVG use references. -->
    <EmbeddedResource Include="wwwroot/lib/circlemetro/circle-icons.svg" LogicalName="Concierge.CircleIcons.svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="CircleAI" Version="$(CircleAiPackageVersion)" />
    <PackageReference Include="Fluxor.Blazor.Web" Version="6.11.0" />
    <!-- MudBlazor — Material-Design Blazor component library. Cross-host: works in
         BlazorWebView (MAUI), Blazor Server (Web), and WASM (Web.Client) without
         per-host shims. We theme it down to the brand palette in ConciergeTheme.cs
         so it does NOT read as "another Material app". -->
    <PackageReference Include="MudBlazor" Version="7.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
    <!-- Diagrams.razor injects PenPotApiClient + FigmaApiClient for the fetch composer.
         The Design adapter project depends on Concierge.Shared but not on this RCL, so
         taking the dependency the other way is safe. -->
    <ProjectReference Include="..\Concierge.Diagrams.Design\Concierge.Diagrams.Design.csproj" />
  </ItemGroup>

</Project>
