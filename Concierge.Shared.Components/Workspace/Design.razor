@using Concierge.Shared.Design
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IDisposable

@*
    Design: say it, see it, point at it.

    One surface. A canvas, a strip of everything it has looked like, and six looks
    to choose between — and nothing else. No file name, no layers, no properties
    panel, no timeline, no code view, no colour picker. Every one of those is a
    thing somebody would have to be taught, and the bar this is built to is that a
    five-year-old and a ninety-seven-year-old can both use it without being taught
    anything.

    The composer underneath is unchanged; it is the "say it" half. What you type
    there while this is open goes to the canvas.

    Three things this deliberately does not have:

      A save button. The design is kept as you go and every state it has been in is
      one tap away. Saving is a thing computers needed, not people.

      An "are you sure". Design acts freely — asking permission to try something is
      what makes a tool unusable for the people this is for, and it teaches somebody
      to stop reading prompts, which ruins every approval elsewhere in Concierge.
      What makes that safe is that going back is free and total.

      Anything that scrolls out of sight. Scrollbars are hidden app-wide, so a
      surface that overflows loses content silently.
*@

@if (_gameHtml is not null)
{
    <div class="dz-game-shell">
        <button class="dz-game-return" type="button" @onclick="CloseGame">← Back to Space</button>
        <iframe class="dz-game-frame" title="Your room game" sandbox="allow-same-origin allow-scripts"
                srcdoc="@_gameHtml"></iframe>
    </div>
}
else
{
<div class="dz">
    <div class="dz-top">
        <span class="dz-what">@_session.Moments[_session.Position].What</span>

        <div class="dz-back">
            @if (_session.Current.Medium == DesignMedium.Motion &&
                (Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench) is { Export: not null, SpatialGameExportRoot: not null } &&
                Services.GetService(typeof(IDraftShare)) is IDraftShare)
            {
                <button class="dz-step dz-game-action" type="button" disabled="@_exportingBook"
                        @onclick="ToggleBookExport" aria-label="Make a book trailer for SleptON!">
                    SleptON!
                </button>
            }
            @if (_session.Current.Medium == DesignMedium.Motion &&
                (Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench) is { Export: not null, SpatialGameExportRoot: not null } &&
                Services.GetService(typeof(IMediaShare)) is IMediaShare)
            {
                <button class="dz-step dz-game-action" type="button" disabled="@_renderingLightMedia"
                        @onclick="ToggleLightMedia" aria-label="Make a Light Media Render for sharing">
                    Light Media
                </button>
            }
            @if (_session.Current.Medium == DesignMedium.Sound &&
                (Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench) is { Export: not null, SpatialGameExportRoot: not null } &&
                Services.GetService(typeof(IDraftShare)) is IDraftShare)
            {
                <button class="dz-step dz-game-action" type="button" disabled="@_exportingAudio"
                        @onclick="ToggleAudioExport" aria-label="Prepare audio for SleptON!">
                    SleptON!
                </button>
            }
            @if (_session.Current.Medium == DesignMedium.Scene &&
                (Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench)?.SpatialGameExportRoot is not null)
            {
                <button class="dz-step dz-game-action" type="button" disabled="@_makingGame"
                        @onclick="PlayGame" title="Make and play a room game" aria-label="Make and play a room game">
                    Play game
                </button>
            }
            <button class="dz-step" type="button" disabled="@(!_session.CanGoBack)"
                    @onclick="Back" title="Go back" aria-label="Go back">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 6 9 12 15 18" />
                </svg>
            </button>
            <button class="dz-step" type="button" disabled="@(!_session.CanGoForward)"
                    @onclick="Forward" title="Go forward" aria-label="Go forward">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 6 15 12 9 18" />
                </svg>
            </button>
        </div>
    </div>
    @if (_gameMessage is not null)
    {
        <p class="dz-game-message" role="status">@_gameMessage</p>
    }
    @if (_showBookExport && _session.Current.Medium == DesignMedium.Motion)
    {
        <div class="dz-audio-export" role="dialog" aria-label="Make a book trailer for SleptON!">
            <strong>Book to 30-second trailer</strong>
            <p>Choose your TXT, EPUB or PDF book. Concierge uses five passages from the source, then sends a private draft to SleptON! for review.</p>
            <label>Book <InputFile OnChange="ReadBookAsync" accept="text/plain,application/epub+zip,application/pdf" disabled="@_exportingBook" /></label>
            @if (_bookSource is not null)
            {
                <p>@_bookSource.FileName · @_bookSource.Passages.Count readable passages</p>
                <label>Trailer title <input @bind="_bookTitle" maxlength="100" /></label>
            }
            @if (_bookExportMessage is not null)
            {
                <p role="status">@_bookExportMessage</p>
            }
            <label><input type="checkbox" @bind="_bookRightsConfirmed" /> I own this book or have permission to share a trailer made from it.</label>
            <button class="btn btn-primary" type="button"
                    disabled="@(_bookSource is null || !_bookRightsConfirmed || _exportingBook)"
                    @onclick="ExportBookTrailerAsync">@(_exportingBook ? "Making trailer…" : "Make and send to SleptON!")</button>
        </div>
    }
    @if (_bookExportMessage is not null && !_showBookExport)
    {
        <p class="dz-audio-export-status" role="status">@_bookExportMessage</p>
    }
    @if (_showLightMedia && _session.Current.Medium == DesignMedium.Motion)
    {
        <div class="dz-audio-export" role="dialog" aria-label="Light Media Render">
            <strong>Light Media Render</strong>
            <p>Make a short, small clip and a poster from the video on this canvas. Share either through your device.</p>
            <button class="btn btn-primary" type="button" disabled="@_renderingLightMedia"
                    @onclick="RenderLightMediaAsync">@(_renderingLightMedia ? "Rendering…" : "Make light media")</button>
            @if (_lightMedia is not null)
            {
                <div class="dz-light-media-actions">
                    <button type="button" disabled="@_renderingLightMedia" @onclick="ShareLightClipAsync">Share clip</button>
                    <button type="button" disabled="@_renderingLightMedia" @onclick="ShareLightPosterAsync">Share poster</button>
                </div>
            }
            @if (_lightMediaMessage is not null) { <p role="status">@_lightMediaMessage</p> }
        </div>
    }
    @if (_showAudioExport && _session.Current.Medium == DesignMedium.Sound)
    {
        <div class="dz-audio-export" role="dialog" aria-label="Send audio to SleptON!">
            <strong>Send audio to SleptON!</strong>
            <p>Your audio stays private. In SleptON!, accept it, review it, then add or decline it. Publishing comes later.</p>
            @if (_audioExportMessage is not null)
            {
                <p role="status">@_audioExportMessage</p>
            }
            <label><input type="checkbox" @bind="_audioRightsConfirmed" /> I own this audio or have permission to share it.</label>
            <button class="btn btn-primary" type="button" disabled="@(!_audioRightsConfirmed || _exportingAudio)"
                    @onclick="ExportAudioDraftAsync">@(_exportingAudio ? "Preparing…" : "Send to SleptON!")</button>
        </div>
    }
    @if (_audioExportMessage is not null && !_showAudioExport)
    {
        <p class="dz-audio-export-status" role="status">@_audioExportMessage</p>
    }

    @*
        The canvas. An iframe rather than the design rendered inline, so a look
        can bring its own background, fonts and spacing without any of it leaking
        into Concierge's own stylesheet — or Concierge's leaking into the design,
        which would make what you see here not what you get anywhere else.
    *@
    <div class="dz-canvas">
        @*
            Both flags, and the reasoning is worth having in one place because each
            was got wrong on its own first.

            allow-same-origin is what lets the click listener be attached inside
            the frame. Without it contentDocument is null and pointing cannot work
            at all.

            allow-scripts is what makes four of the five renderers do anything.
            Arrow keys through a deck, a video that plays, a room that turns, a
            running order that plays end to end — all of it is script inside the
            document. Without this the designs still drew perfectly and did
            nothing, which is exactly the sort of thing that passes a test suite
            and fails a person.

            The pair is the combination usually warned about, because framed
            content can then remove its own sandbox. What makes it safe here is
            not the sandbox: it is that the document is generated by our own
            renderer, every piece of text is escaped, and picture and audio
            sources are restricted to http, https and data. There is no path for
            anything to arrive that was not written by this application.
        *@
        <iframe class="dz-frame" title="Your design" sandbox="allow-same-origin allow-scripts"
                srcdoc="@_session.Html()" @ref="_frame"></iframe>

        @if (_session.Current.Medium == DesignMedium.Scene && _session.Current.Frames.Count == 0 &&
            (Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench)?.SpatialGameExportRoot is not null)
        {
            <button class="dz-sample-room" type="button" @onclick="TrySampleRoom">
                Try a sample room
            </button>
        }

        @if (_touched is not null)
        {
            <div class="dz-touched">
                <span>@_touched</span>
                <button class="dz-untouch" type="button" @onclick="() => Point(null)">Let go</button>
            </div>
        }
    </div>

    @*
        Everything it has looked like, as pictures. Not a list of changes — "Set
        node_4f2a text" is unreadable, and a person deciding which version they
        liked is looking for the one that looked right, not the one described
        correctly.
    *@
    @*
        One stack along the bottom edge, over the drawing.

        These used to be three rows of the page's own grid, which cost the drawing half its
        height. Hanging them individually off the bottom was worse: each needed to know how
        tall the others were, and the first attempt had the history strip sitting on top of
        the media picker. One flex column knows its own height.
    *@
    <div class="dz-controls">
    <div class="dz-past" role="group" aria-label="How it looked before">
        @for (var i = 0; i < _session.Moments.Count; i++)
        {
            var at = i;
            var moment = _session.Moments[at];

            <button class="dz-moment @(at == _session.Position ? "is-now" : string.Empty)"
                    type="button" @onclick="() => GoTo(at)" title="@moment.What">
                <span class="dz-thumb">
                    <iframe class="dz-thumb-frame" tabindex="-1" aria-hidden="true"
                            sandbox="" srcdoc="@_session.HtmlAt(at)"></iframe>
                </span>
                <span class="dz-moment-what">@moment.What</span>
            </button>
        }
    </div>

    @*
        What is being made. Five, chosen by pointing at one.

        Above the looks rather than below, because it is the bigger question: what
        this is decides what "add one" even means — a slide, a shot, a room, a
        track. The word under each is the one a person would use, so nobody has to
        learn that a deck is called a deck.
    *@
    <div class="dz-looks dz-mediums" role="group" aria-label="What you are making">
        @foreach (var medium in DesignMediums.All)
        {
            var pick = medium;

            <button class="dz-look @(_session.Current.Medium == pick.Medium ? "is-on" : string.Empty)"
                    type="button" @onclick="() => Make(pick.Medium)" title="@pick.Blurb">
                <span class="dz-kind" aria-hidden="true">@Glyph(pick.Medium)</span>
                <span class="dz-look-name">@pick.Name</span>
            </button>
        }
    </div>

    @*
        How it should look, chosen by pointing at one. Never a colour, never a
        font name, never a file — six pictures and a word.
    *@
    <div class="dz-looks" role="group" aria-label="How it should look">
        @foreach (var look in DesignLooks.All)
        {
            var name = look.Name;

            <button class="dz-look @(string.Equals(_session.Current.Look, name, StringComparison.OrdinalIgnoreCase) ? "is-on" : string.Empty)"
                    type="button" @onclick="() => Wear(name)" title="@look.Blurb">
                <span class="dz-swatch" style="background:@look.Ground;border-color:@look.Raised">
                    <span class="dz-swatch-ink" style="background:@look.Ink"></span>
                    <span class="dz-swatch-accent" style="background:@look.Accent"></span>
                </span>
                <span class="dz-look-name">@name</span>
            </button>
        }
    </div>
    </div>
</div>
}

@code {
    /// <summary>The design being worked on. Owned by the workspace, so it survives
    /// this component being torn down and rebuilt by a resize.</summary>
    [Parameter, EditorRequired] public DesignSession Session { get; set; } = default!;

    /// <summary>Told when something changed, so the workspace can redraw around it.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private DesignSession _session = default!;
    private ElementReference _frame;
    private string? _touched;
    private DotNetObjectReference<Design>? _self;
    private bool _wired;
    private bool _makingGame;
    private string? _gameMessage;
    private string? _gameHtml;
    private bool _showAudioExport;
    private bool _audioRightsConfirmed;
    private bool _exportingAudio;
    private string? _audioExportMessage;
    private bool _showBookExport;
    private bool _bookRightsConfirmed;
    private bool _exportingBook;
    private string _bookTitle = string.Empty;
    private BookTrailerSource? _bookSource;
    private string? _bookExportMessage;
    private bool _showLightMedia;
    private bool _renderingLightMedia;
    private LightMediaResult? _lightMedia;
    private string? _lightMediaMessage;

    private void ToggleLightMedia()
    {
        _showLightMedia = !_showLightMedia;
        if (_showLightMedia) _lightMediaMessage = null;
    }

    private async Task RenderLightMediaAsync()
    {
        if (_renderingLightMedia || _session.Current.Medium != DesignMedium.Motion) return;
        var workbench = Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench;
        if (workbench?.Export is not { } media || workbench.SpatialGameExportRoot is not { } root) return;
        _renderingLightMedia = true;
        _lightMedia = null;
        _lightMediaMessage = "Rendering a short clip and poster…";
        var temporary = Path.Combine(root, "light-media-source-" + Guid.NewGuid().ToString("N") + ".mp4");
        try
        {
            Directory.CreateDirectory(root);
            var full = await media.VideoAsync(_session.Current, temporary);
            if (!full.Ok || full.Left is not null)
                throw new InvalidDataException(full.Problem ?? full.Left ?? "The video is incomplete.");
            _lightMedia = await LightMediaRender.CreateAsync(temporary,
                Path.Combine(root, "Light Media"), Encoders.Runner);
            _lightMediaMessage = "Clip and poster ready. Choose what to share.";
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException
            or InvalidOperationException or ArgumentException)
        {
            _lightMediaMessage = "Light Media Render failed: " + error.Message;
        }
        finally
        {
            if (File.Exists(temporary)) File.Delete(temporary);
            _renderingLightMedia = false;
        }
    }

    private Task ShareLightClipAsync() => ShareLightAsync(_lightMedia?.ClipPath, "video/mp4", "Share light video clip");
    private Task ShareLightPosterAsync() => ShareLightAsync(_lightMedia?.PosterPath, "image/png", "Share light poster");

    private async Task ShareLightAsync(string? path, string mediaType, string title)
    {
        if (path is null || Services.GetService(typeof(IMediaShare)) is not IMediaShare share) return;
        try { await share.ShareAsync(path, mediaType, title); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException)
        { _lightMediaMessage = "Could not share: " + error.Message; }
    }

    private void ToggleBookExport()
    {
        _showBookExport = !_showBookExport;
        if (_showBookExport) _bookExportMessage = null;
        else _bookRightsConfirmed = false;
    }

    private async Task ReadBookAsync(InputFileChangeEventArgs args)
    {
        _bookSource = null;
        _bookExportMessage = "Reading your book…";
        try
        {
            await using var stream = args.File.OpenReadStream(BookTrailerSourceReader.MaxSourceBytes + 1);
            _bookSource = await BookTrailerSourceReader.ReadAsync(stream, args.File.Name);
            _bookTitle = Path.GetFileNameWithoutExtension(_bookSource.FileName);
            _bookExportMessage = null;
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            _bookExportMessage = $"Could not read this book: {error.Message}";
        }
    }

    private async Task ExportBookTrailerAsync()
    {
        if (_exportingBook || !_bookRightsConfirmed || _bookSource is null ||
            _session.Current.Medium != DesignMedium.Motion) return;
        var workbench = Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench;
        var share = Services.GetService(typeof(IDraftShare)) as IDraftShare;
        if (workbench?.Export is not { } encoder || workbench.SpatialGameExportRoot is not { } root || share is null)
            return;
        _exportingBook = true;
        _bookExportMessage = "Making your 30-second trailer…";
        try
        {
            var package = await BookTrailerPackage.CreateAsync(_bookSource, _bookTitle, root,
                encoder, rightsConfirmed: true);
            _bookExportMessage = "Trailer ready. Opening SleptON!…";
            var handoff = await share.ShareAsync(package);
            _bookExportMessage = handoff == DraftShareResult.OpenedSleptOn
                ? "Opened SleptON!. Accept, review and add the private draft there, or decline it."
                : "Choose SleptON! from the sharing options. The trailer has not been added or published.";
            _showBookExport = false;
            _bookRightsConfirmed = false;
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            _bookExportMessage = $"The trailer could not be sent: {error.Message}";
        }
        finally { _exportingBook = false; }
    }

    private void ToggleAudioExport()
    {
        _showAudioExport = !_showAudioExport;
        if (_showAudioExport) _audioExportMessage = null;
        else _audioRightsConfirmed = false;
    }

    private async Task ExportAudioDraftAsync()
    {
        if (_exportingAudio || !_audioRightsConfirmed || _session.Current.Medium != DesignMedium.Sound)
            return;
        var workbench = Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench;
        var share = Services.GetService(typeof(IDraftShare)) as IDraftShare;
        if (workbench?.Export is not { } encoder || workbench.SpatialGameExportRoot is not { } root || share is null)
            return;
        _exportingAudio = true;
        _audioExportMessage = "Preparing your audio draft…";
        var temporaryAudio = Path.Combine(root, "audio-export-" + Guid.NewGuid().ToString("N") + ".m4a");
        try
        {
            Directory.CreateDirectory(root);
            var result = await encoder.SoundAsync(_session.Current, temporaryAudio);
            if (!result.Ok || result.Left is not null)
                throw new InvalidDataException(result.Problem ?? result.Left ?? "The audio export is incomplete.");
            var title = _session.Current.ChildrenOf(_session.Current.RootId)
                .LastOrDefault(node => node.Kind == DesignNodeKind.Sound)?.Text;
            if (string.IsNullOrWhiteSpace(title) || title.Length > 100) title = "My audio draft";
            var package = await Task.Run(() => AudioDraftPackage.Create(temporaryAudio, title, root, rightsConfirmed: true));
            var handoff = await share.ShareAsync(package);
            _audioExportMessage = handoff == DraftShareResult.OpenedSleptOn
                ? "Opened SleptON!. Your draft will appear in its incoming queue after it validates the file. Review it there before adding it."
                : "Choose SleptON! or save the draft ZIP from the sharing options. It has not been added or published.";
            _showAudioExport = false;
            _audioRightsConfirmed = false;
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidDataException
            or InvalidOperationException or ArgumentException)
        {
            _audioExportMessage = error.Message;
        }
        finally
        {
            if (File.Exists(temporaryAudio)) File.Delete(temporaryAudio);
            _exportingAudio = false;
        }
    }

    private void CloseGame()
    {
        _gameHtml = null;
        _gameMessage = "Back in Space. Your room is ready to edit.";
        _self?.Dispose();
        _self = null;
        _wired = false;
    }

    private void TrySampleRoom()
    {
        if (_session.Current.Medium != DesignMedium.Scene || _session.Current.Frames.Count != 0)
            return;
        _session.Record(SpatialGameSample.AddTo(_session.Current), "Added a sample room");
        _gameMessage = "Sample room added. Tap Play game to try it.";
    }

    private async Task PlayGame()
    {
        if (_makingGame)
            return;
        _makingGame = true;
        _gameMessage = "Making your room game…";
        try
        {
            var workbench = Services.GetService(typeof(DesignWorkbench)) as DesignWorkbench;
            if (workbench?.SpatialGameExportRoot is not { } root)
                throw new InvalidOperationException("This device cannot save a game draft.");
            var title = _session.Current.Frames.LastOrDefault()?.Text;
            var package = await Task.Run(() => SpatialGamePackage.Create(_session.Current,
                string.IsNullOrWhiteSpace(title) ? "My room game" : title, root));
            _gameHtml = SpatialGameInlinePreview.FromPackage(package);
            _gameMessage = null;
        }
        catch (Exception error) when (error is InvalidDataException or IOException or UnauthorizedAccessException
            or ArgumentException or InvalidOperationException)
        {
            _gameMessage = error.Message;
        }
        finally
        {
            _makingGame = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_session, Session))
        {
            return;
        }

        if (_session is not null)
        {
            _session.Changed -= OnSessionChanged;
        }

        _session = Session;
        _session.Changed += OnSessionChanged;
        Describe();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Clicks land inside the iframe, so the listener has to be attached in
        // there. The document is same-origin (srcdoc), which is what makes this
        // possible at all — and is why the canvas is srcdoc rather than a URL.
        if (!_wired)
        {
            _self = DotNetObjectReference.Create(this);

            try
            {
                await JS.InvokeVoidAsync("conciergeDesign.watch", _frame, _self);
                _wired = true;
            }
            catch (JSException)
            {
                // Pointing is the better way to correct something and not the only
                // one — every sentence still works. A canvas you cannot click is
                // worse than one you can; a canvas that throws on load is useless.
            }
        }
    }

    /// <summary>
    /// Something on the canvas was touched. Called from the page inside the frame.
    /// </summary>
    [JSInvokable]
    public void Touched(string? nodeId)
    {
        Point(nodeId);
    }

    /// <summary>
    /// How the room got drawn. Called from the page inside the frame.
    ///
    /// A room that falls back to the flat drawing works perfectly, which is the
    /// whole point of drawing it that way — and is exactly why nobody would ever
    /// find out it had. Engineering says which, so "why does my room look flat?"
    /// has an answer that is not a guess.
    /// </summary>
    [JSInvokable]
    public void Drew(bool engine, string? why)
    {
        if (Services.GetService(typeof(SceneEngineReport)) is not SceneEngineReport report)
        {
            // A head that does not keep the report keeps its canvas. This is a
            // thing Engineering shows, not a thing the canvas needs.
            return;
        }

        if (engine)
        {
            report.Drew();
        }
        else
        {
            report.FellBack(why);
        }
    }

    private void Point(string? nodeId)
    {
        _session.Point(nodeId);
        Describe();
        StateHasChanged();
    }

    private void Back()
    {
        _session.Back();
        Describe();
    }

    private void Forward()
    {
        _session.Forward();
        Describe();
    }

    private void GoTo(int position)
    {
        _session.GoTo(position);
        Describe();
    }

    private void Wear(string look)
    {
        _session.Record(_session.Current.Wearing(look), $"Made it {look.ToLowerInvariant()}");
    }

    /// <summary>
    /// Changes what is being made. Nothing on the canvas is thrown away — the same
    /// words and pictures, drawn a different way — so changing your mind costs
    /// nothing and is one tap back regardless.
    /// </summary>
    private void Make(DesignMedium medium)
    {
        if (_session.Current.Medium == medium)
        {
            return;
        }

        _session.Record(
            _session.Current.As(medium),
            $"Made it {DesignMediums.Of(medium).Name.ToLowerInvariant()}");
    }

    /// <summary>
    /// A shape for each medium. Drawn rather than named because the row has to
    /// read at a glance on a phone, where the words are hidden.
    /// </summary>
    private static string Glyph(DesignMedium medium) => medium switch
    {
        DesignMedium.Deck => "▤",
        DesignMedium.Motion => "▶",
        DesignMedium.Scene => "◳",
        DesignMedium.Sound => "♫",
        _ => "▭",
    };

    /// <summary>
    /// What is being pointed at, in the words a person would use. "The title" and
    /// not "heading#4f2a1c" — this is read at a glance while deciding what to say
    /// next.
    ///
    /// **Every kind is named.** Three were missing and all three fell through to
    /// "The page": pointing at a block in a room, a track in a running order, or a
    /// slide said the page had been touched, and the very next sentence was then
    /// about the wrong thing. Caught by clicking a box in a room and reading the
    /// chip — the same class of defect as an approvals badge that always said two,
    /// on the one strip whose whole job is saying what you just touched.
    ///
    /// A frame borrows the medium's own word, so it is a slide on a deck, a shot
    /// in a film and a room in a space.
    /// </summary>
    private void Describe()
    {
        _touched = _session.Pointed is { } node
            ? node.Kind == DesignNodeKind.Page
                ? "The page"
                : $"This {DesignSpeech.NameFor(node.Kind, _session.Current.Medium)}"
            : null;
    }

    /// <summary>
    /// The session changed, possibly from a thread that is not the renderer's.
    ///
    /// **This killed the whole app.** `await InvokeAsync(StateHasChanged)` marshals that one
    /// call correctly — and then the continuation resumes on whatever thread raised the
    /// event, so `Changed.InvokeAsync()` reached the workspace's own StateHasChanged off the
    /// dispatcher and threw "The current thread is not associated with the Dispatcher". In an
    /// `async void` that is an unhandled exception on a thread-pool thread, which does not
    /// fail the edit — it takes the process down. Concierge vanished from the screen twice
    /// before the trace was captured.
    ///
    /// It only shows when a tool does real asynchronous work before recording: reading files
    /// off a disk, fetching a sound, generating a picture, speaking words. Everything that
    /// records synchronously stays on the dispatcher by luck, which is why a surface this old
    /// had never done it.
    ///
    /// Everything is inside one `InvokeAsync` now, so the whole handler — including the
    /// parent's callback — runs where the renderer lives. And it is no longer `async void`,
    /// so a future fault in here costs the update rather than the application.
    /// </summary>
    private void OnSessionChanged(object? sender, EventArgs e)
        => _ = InvokeAsync(async () =>
        {
            Describe();
            StateHasChanged();
            await Changed.InvokeAsync();
        });

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.Changed -= OnSessionChanged;
        }

        _self?.Dispose();
    }
}
