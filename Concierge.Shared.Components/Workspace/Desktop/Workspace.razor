@inherits Concierge.Shared.Components.Workspace.WorkspaceBase
<ConnectedDevices />

@*
    The desktop and web recipe.

    A sidebar you can see while you work, one thread beside it, and the two
    controls that carry consequence under the composer. This is the markup that
    was Pages/Chat.razor, moved unchanged: the routes, the services and
    IDisposable moved to WorkspaceBase, and nothing else about it altered.

    It is a separate component from the handheld and wearable recipes rather
    than the same tree with breakpoints, so that changing one of them cannot
    reach this one.
*@

@using System.Text
@using System.Text.Json.Nodes
@using Concierge.Shared.Chat
@using Concierge.Shared.Tools
@using Concierge.Shared.Components.Workspace

@*
    The workspace.

    This is the whole application now. Concierge had nineteen routes, a bottom
    tab bar and a ⋯ menu; neither of the references it is meant to resemble has
    any of that. Codex is a sidebar of threads and one thread beside it. Claude
    Design is a conversation and the work it produces, side by side. Nothing
    navigates anywhere in either.

    So: threads, skills and approvals are sections of a sidebar you can see
    while you work, not destinations. Permission is asked inside the thread at
    the point the run stopped. What the model is, and whether it may act without
    asking, live under the composer where Codex puts them — both were screens.
*@

@{
    var snapshot = State.GetSnapshot();
    var runtime = LlmRuntime.GetSnapshot();
    var recent = _conversations.Take(6).ToList();
    var createLinks = new[] { (Name: "Diagrams", Href: "diagrams"), (Name: "Images", Href: "images") };
    var aboutLinks = new[]
    {
        (Name: "What Concierge can do", Href: "product"),
        (Name: "How it works", Href: "engineering"),
        (Name: "More than coding", Href: "beyond"),
        (Name: "Business connections", Href: "business-apis"),
        (Name: "Coming next", Href: "roadmap"),
        (Name: "What's new", Href: "release"),
        (Name: "Plans and pricing", Href: "pricing")
    };
    var scopedWorkflows = _turnProject is null
        ? Array.Empty<Concierge.Shared.Planning.ProjectWorkflow>()
        : _turnProjectWorkspace is null
            ? _turnProject.Workflows
            : _turnProject.Workflows.Where(workflow => _turnProjectWorkspace.WorkflowIds.Contains(workflow.Id)).ToArray();
    var workflowCount = scopedWorkflows.Count;
    var completedWorkflowCount = scopedWorkflows.Count(workflow => workflow.Status == Concierge.Shared.Planning.ProjectWorkStatus.Completed);
    var scopedArtifactCount = _turnProject is null
        ? 0
        : _turnProjectWorkspace is null
            ? _turnProject.Artifacts.Count
            : _turnProject.Artifacts.Count(artifact => _turnProjectWorkspace.ArtifactIds.Contains(artifact.Id));
    var openConversationApprovals = _approvalHistory.Count(approval => approval.Decision is null
        && _pendingApprovals.Any(pending => pending.Id == approval.ApprovalId));
    var hasConversationWork = _active?.Messages.Any(message => message.Role == "user") == true;
}

<div class="ws" aria-busy="@(!WorkspaceReady ? "true" : "false")">
    @if (!WorkspaceReady) { <span class="sr" role="status">Loading your workspace…</span> }

    @*
        A column, always on screen. The drawer, the scrim and the menu control
        live in the handheld recipe — there is no width at which this component
        renders on a phone, so carrying them here would be carrying a
        presentation it never uses.
    *@
    <aside class="ws-side">
        <a class="ws-brand" href="/">
            <span class="ws-brand-dot" aria-hidden="true"></span>
            <span class="ws-brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#cm-icon-circle" /></svg></span>
            <span class="ws-brand-lockup"><strong>Concierge</strong><small>by Circle</small></span>
        </a>

        <div class="ws-scroll">
            <button class="ws-item ws-start-conversation" type="button" @onclick="StartNewAsync">
                <span class="ws-new-thread-mark" aria-hidden="true">+</span>
                <span class="ws-item-label">New conversation</span>
                <span class="ws-start-hint">Start here</span>
            </button>
            <a class="ws-item ws-project-link" href="@(_active is null ? "/projects" : $"/projects?conversation={_active.Id}")">
                <span class="ws-new-thread-mark" aria-hidden="true">◇</span>
                <span class="ws-item-label">Projects</span>
                <span class="ws-start-hint">Organize bigger goals</span>
            </a>
            <WorkDestinations />
            @*
                Long lists are folded, not scrolled. Threads and Approvals open
                because they are what is happening; Skills is a catalogue of
                sixty-nine and stays shut until asked for. A closed group still
                shows its count, so a folded Approvals still says two are
                waiting on you.
            *@
            <section class="ws-group ws-group-threads @(IsGroupOpen("threads") ? "is-open" : null)">
                <button class="ws-head" type="button" aria-expanded="@(IsGroupOpen("threads") ? "true" : "false")" @onclick='@(() => ToggleGroup("threads"))'>
                    <svg class="ws-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-message" /></svg>
                    <svg class="ws-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                    <span class="ws-head-name">Recent conversations</span>
                    <span class="ws-head-count">@_conversations.Count</span>
                </button>
                @if (IsGroupOpen("threads"))
                {
                    <div class="ws-group-body" id="desktop-recent-conversations">
                        @*
                            The three most recent, then the rest on request.
                            Four threads plus four group headers overflowed the
                            sidebar by 67px, which put Rooms below the fold and
                            Skills behind the runtime footer — and with
                            scrollbars hidden app-wide, nothing said so.
                        *@
                        @foreach (var conversation in (_allThreads ? _conversations : _conversations.Take(3)))
                        {
                            var conv = conversation;
                            <a class="ws-item @(conv.Id == _active?.Id ? "is-active" : null)" href="@($"/chat/{conv.Id}")">
                                @*
                                    A thread you have left can still be working.
                                    Without this the run is invisible: leaving
                                    used to stop it, so there was never anything
                                    to show.
                                *@
                                @if (IsConversationRunning(conv.Id))
                                {
                                    <span class="dot dot-waiting" aria-hidden="true"></span>
                                }
                                <span class="ws-item-label">@conv.Title</span>
                                <span class="ws-item-meta">@(IsConversationRunning(conv.Id) ? "working" : Ago(conv.UpdatedAt))</span>
                            </a>
                        }
                        @if (!_allThreads && _conversations.Count > 3)
                        {
                            <button class="ws-more" type="button"
                                    @onclick="@(() => _allThreads = true)">
                                Show all conversations
                            </button>
                        }
                        <a class="ws-more ws-history-link" href="history">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-search" /></svg>
                            Find an older conversation
                        </a>
                    </div>
                }
            </section>

            <section class="ws-group ws-group-approvals @(IsGroupOpen("approvals") ? "is-open" : null)">
                <button class="ws-head" type="button" aria-expanded="@(IsGroupOpen("approvals") ? "true" : "false")" @onclick='@(() => ToggleGroup("approvals"))'>
                    <svg class="ws-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-shield" /></svg>
                    <svg class="ws-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                    <span class="ws-head-name">Needs your OK</span>
                    <span class="ws-head-count">@_pendingApprovals.Count</span>
                </button>
                @if (IsGroupOpen("approvals"))
                {
                    <div class="ws-group-body" id="desktop-approval-summary">
                        @if (_pendingApprovals.Count == 0)
                        {
                            <p class="ws-group-note">Circle AI pauses here when an action needs your permission. You're all caught up.</p>
                        }
                        @foreach (var approval in _pendingApprovals)
                        {
                            <span class="ws-item" style="cursor:default;">
                                <span class="dot @RiskDot(approval.Request.Risk)" aria-hidden="true"></span>
                                <span class="ws-item-label">@approval.Request.Summary</span>
                                <span class="ws-item-meta">@Ago(approval.AskedAt)</span>
                            </span>
                        }
                        @*
                            The queue seen all at once, for clearing it rather
                            than happening upon it. Deciding still happens in
                            the thread where the run stopped; this is the
                            overview, and without it /approvals is a route
                            nothing reaches.
                        *@
                        <a class="ws-more" href="approvals">Review requests</a>
                    </div>
                }
            </section>

            @*
                What is ON, not all sixty-nine. An active skill composes into the
                system prompt before every turn, so it is shaping the answers —
                that is worth a permanent place. The catalogue is a search, and
                searches belong behind a control, not in a sidebar.
            *@
            <section class="ws-group ws-group-skills @(IsGroupOpen("skills") ? "is-open" : null)">
                <button class="ws-head" type="button" aria-expanded="@(IsGroupOpen("skills") ? "true" : "false")" @onclick='@(() => ToggleGroup("skills"))'>
                    <svg class="ws-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-star" /></svg>
                    <svg class="ws-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                    <span class="ws-head-name">Personalize Circle AI</span>
                    @if (_activeSkillIds.Count > 0)
                    {
                        <span class="ws-head-count">@_activeSkillIds.Count</span>
                    }
                </button>
                @if (IsGroupOpen("skills"))
                {
                    <div class="ws-group-body" id="desktop-personalize">
                        @if (_activeSkillIds.Count == 0)
                        {
                            <p class="ws-group-note">Add specialist help for the kinds of things you do.</p>
                        }
                        else
                        {
                            @foreach (var skill in snapshot.Skills.Where(s => _activeSkillIds.Contains(s.Id)))
                            {
                                var activeId = skill.Id;
                                <button class="ws-item" type="button" title="Turn off this ability"
                                        @onclick="@(() => DeactivateSkill(activeId))">
                                    <span class="dot dot-done" aria-hidden="true"></span>
                                    <span class="ws-item-label">@skill.Name</span>
                                    <span class="ws-item-meta">on · turn off</span>
                                </button>
                            }
                        }
                        <button class="ws-more" type="button" @onclick="ToggleSkillPicker">
                            Browse abilities
                        </button>
                    </div>
                }
            </section>

            <section class="ws-group ws-group-create @(IsGroupOpen("create") ? "is-open" : null)">
                <button class="ws-head" type="button" aria-expanded="@(IsGroupOpen("create") ? "true" : "false")" @onclick='@(() => ToggleGroup("create"))'>
                    <svg class="ws-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-edit" /></svg>
                    <svg class="ws-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                    <span class="ws-head-name">Make something</span>
                </button>
                @if (IsGroupOpen("create"))
                {
                    <div class="ws-group-body" id="desktop-create">
                        <button class="ws-room ws-room-btn @(_designOpen ? "is-on" : null)" type="button" @onclick="ToggleDesign">
                            @(_designOpen ? "Close Creator" : "Open Creator")
                        </button>
                        @foreach (var item in createLinks)
                        {
                            <a class="ws-room" href="@item.Href">@item.Name</a>
                        }
                    </div>
                }
            </section>

            <section class="ws-group ws-group-about @(IsGroupOpen("about") ? "is-open" : null)">
                <button class="ws-head" type="button" aria-expanded="@(IsGroupOpen("about") ? "true" : "false")" @onclick='@(() => ToggleGroup("about"))'>
                    <svg class="ws-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-info" /></svg>
                    <svg class="ws-chev" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                    <span class="ws-head-name">About &amp; updates</span>
                </button>
                @if (IsGroupOpen("about"))
                {
                    <div class="ws-group-body" id="desktop-about">
                        @foreach (var item in aboutLinks)
                        {
                            <a class="ws-room" href="@item.Href">@item.Name</a>
                        }
                    </div>
                }
            </section>
        </div>

        @*
            Circle AI status, permanently on screen — and the way into settings.
            Windows desktop lets Circle AI choose the model automatically, so
            this is a status label rather than a provider control.
        *@
        <button class="ws-runtime" type="button" title="Open Circle AI and app settings" aria-label="Open Circle AI and app settings"
                @onclick="OpenSettings">
            <span class="ws-ai-emblem" aria-hidden="true"><svg viewBox="0 0 24 24"><use href="#cm-icon-circle" /></svg><i class="@(runtime.RegistryAvailable ? "is-ready" : null)"></i></span>
            <span class="ws-ai-copy"><span class="ws-ai-title">Circle AI</span><span class="ws-runtime-name">AI and app settings</span></span>
            @* Was the literal text "on device", under whichever engine was
               selected — including the three that are a cloud provider. The
               sidebar was contradicting the product's main claim on the one
               line where somebody would look to check it.

               Nothing at all when no runtime is answering: with no engine
               there is no honest version of either label, and guessing would
               reintroduce the same fault in the other direction. *@
            @if (_activeRuntime is not null)
            {
                <span class="ws-item-meta">Settings</span>
            }
        </button>
    </aside>

    <main class="ws-main">
        <header class="ws-top">
            @*
                With the canvas open the header said the title of whatever thread
                was last open — a heading describing something that is not on
                screen, in the one place a person looks to know where they are.
            *@
            <h1 class="ws-title">@(_designOpen ? "Creator" : _active?.Title ?? "Concierge")</h1>
            <span class="ws-top-meta">
                @if (_projectContextLabel is not null)
                {
                    <span class="ws-context-label">@_workContextKind · @_projectContextLabel</span>
                }
                else if (_projectContextUnavailable is not null)
                {
                    <span class="ws-context-unavailable" role="status">@_projectContextUnavailable</span>
                }
                @if (_designOpen && _streaming)
                {
                    @* A turn that fell through to the model runs with no sign of it at all:
                       this line showed the last design moment, so the screen looked idle
                       while something was happening. An ordinary sentence is still answered
                       locally and never gets here. *@
                    <span class="dot dot-waiting" aria-hidden="true"></span>
                    <span>@(_toolLoopIteration > 0 ? $"working · step {_toolLoopIteration}" : "thinking")</span>
                }
                else if (_designOpen)
                {
                    @* No engine is answering, because none is needed. Naming one
                       here would credit a model for work it did not do. *@
                    <span>@(_design!.Current.IsEmpty ? "an empty page" : _design.Moments[_design.Position].What.ToLowerInvariant())</span>
                }
                else if (_streaming)
                {
                    <span class="dot dot-waiting" aria-hidden="true"></span>
                    <span>@(_toolLoopIteration > 0 ? $"working · step {_toolLoopIteration}" : "thinking")</span>
                }
                else
                {
                    <span>Powered by Circle AI</span>
                }
            </span>
        </header>

        @if (_turnProject is { } currentProject)
        {
            <section class="ws-goal-overview" aria-label="Project goal and progress">
                <div class="ws-goal-heading">
                    <div class="ws-goal-name-block">
                        <span class="ws-goal-kicker">@(_turnProjectWorkspace is null ? "PROJECT GOAL" : "WORKSPACE GOAL")</span>
                        <strong>@(_turnProjectWorkspace?.Name ?? currentProject.Name)</strong>
                    </div>
                    <span class="ws-goal-status" data-state="@(_turnProjectWorkspace is null ? ProjectStatusKey(currentProject.Status) : ProjectWorkStatusKey(_turnProjectWorkspace.Status))">
                        @(_turnProjectWorkspace is null ? ProjectStatusLabel(currentProject.Status) : ProjectWorkStatusLabel(_turnProjectWorkspace.Status))
                    </span>
                    <a class="ws-goal-open" href="@ProjectOverviewHref()">Open project overview <span aria-hidden="true">↗</span></a>
                </div>
                <p class="ws-goal-outcome">@(_turnProjectWorkspace?.DesiredOutcome ?? currentProject.DesiredOutcome)</p>
                <div class="ws-goal-facts" aria-label="Work summary">
                    @if (workflowCount > 0)
                    {
                        <span><strong>@completedWorkflowCount/@workflowCount</strong> workflows complete</span>
                    }
                    else
                    {
                        <span>No workflows added yet</span>
                    }
                    <span><strong>@scopedArtifactCount</strong> tracked reference@(scopedArtifactCount == 1 ? "" : "s")</span>
                    <span class="ws-goal-live" role="status" aria-live="polite">
                        <strong>@ConversationStatusText(openConversationApprovals)</strong>
                    </span>
                </div>
            </section>
        }
        else if (_turnStartup is { } currentStartup)
        {
            <section class="ws-goal-overview ws-goal-startup" aria-label="Start-Up goal and progress">
                <div class="ws-goal-heading">
                    <div class="ws-goal-name-block">
                        <span class="ws-goal-kicker">START-UP GOAL · @(currentStartup.Type == Concierge.Shared.Planning.BusinessJourneyType.NewBusiness ? "NEW BUSINESS" : "EXISTING BUSINESS")</span>
                        <strong>@currentStartup.Name</strong>
                    </div>
                    <span class="ws-goal-status" data-state="@ProjectStatusKey(currentStartup.Status)">@ProjectStatusLabel(currentStartup.Status)</span>
                    <a class="ws-goal-open" href="/projects">Open Start-Up overview <span aria-hidden="true">↗</span></a>
                </div>
                <p class="ws-goal-outcome">@currentStartup.Goal</p>
                <div class="ws-goal-facts">
                    <span><strong>@currentStartup.ProjectIds.Count</strong> connected project@(currentStartup.ProjectIds.Count == 1 ? "" : "s")</span>
                    <span class="ws-goal-live" role="status" aria-live="polite">
                        <strong>@ConversationStatusText(0)</strong>
                    </span>
                </div>
            </section>
        }
        else if (hasConversationWork)
        {
            <div class="ws-track-goal">
                <span>Want to keep this goal, its conversations, and deliverables together?</span>
                <a href="@($"/projects?conversation={_active!.Id}")">Track it as a Project <span aria-hidden="true">↗</span></a>
            </div>
        }

        @*
            Design takes the middle of the workspace rather than opening a tab or
            a page. That is the difference between a fourth posture and a fourth
            app: the sidebar stays where it is, the composer underneath is the
            same composer, and what you type goes to the canvas instead of the
            thread. Nineteen routes and a tab bar were removed to get to one
            workspace; adding a place to travel to would walk that back.
        *@
        @if (_designOpen)
        {
            <Design Session="_design!" Changed="StateHasChanged" />
        }
        else if (_active is null || (_active.Messages.Count == 0 && _approvalHistory.Count == 0 && _runRecoveryStatus is null))
        {
            <div class="empty desktop-legacy-empty">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 5h16v11H8l-4 4z"/>
                </svg>
                <span class="empty-line">Ask for anything, or pick up a thread</span>
            </div>
            <WelcomePanel OnPromptSelected="UseStarterPrompt" CapabilityCatalog="CircleAiCapabilityCatalog" />
        }
        else
        {
            <div class="ws-thread">
                <div class="ws-thread-inner">
                    @foreach (var message in _active.Messages)
                    {
                        if (message.Role == "tool")
                        {
                            var receipt = ToolResultPresentation.From(message.Content);
                            var open = _openTools.Contains(message.Id);

                            <div class="chips" data-tool-success="@(receipt.Succeeded?.ToString().ToLowerInvariant() ?? "unknown")">
                                <button class="chip" type="button" aria-expanded="@(open ? "true" : "false")"
                                        @onclick="@(() => ToggleTool(message.Id))">
                                    <svg class="chip-bolt" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12z"/></svg>
                                    <span class="chip-what">@receipt.Headline</span>
                                    @if (receipt.Details.Length > 0)
                                    {
                                        <svg class="chip-more" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                                    }
                                </button>
                                @if (open && receipt.Details.Length > 0)
                                {
                                    <pre class="chip-out">@receipt.Details</pre>
                                }
                            </div>
                        }
                        @* A tool-request turn is an instruction to Concierge, not the
                           finished reply. The receipt below shows what actually ran;
                           the next assistant turn carries the answer. *@
                        else if (message.Role != "assistant"
                            || !message.Content.Contains("```tool-call", StringComparison.Ordinal)
                            || ToolCallProtocol.Extract(message.Content).Count == 0)
                        {
                            <article class="msg">
                                <span class="msg-who">@FormatRole(message.Role)</span>
                                <div class="msg-body">
                                    @if (message.Role == "assistant")
                                    {
                                        <AssistantContent Content="@message.Content" />
                                        <button class="msg-audio" type="button" title="Read this reply aloud"
                                                @onclick="@(() => SpeakAsync(message.Content))">
                                            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#cm-icon-play"/></svg>
                                            <span>Read aloud</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <p>@message.Content</p>
                                    }
                                    <button class="msg-audio" type="button" title="Copy this message"
                                            @onclick="@(() => CopyMessageAsync(message.Id, message.Content))">
                                        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="#cm-icon-copy"/></svg>
                                        <span aria-live="polite">@CopyMessageLabel(message.Id)</span>
                                    </button>
                                </div>
                            </article>
                        }
                    }

                    @if (_approvalHistory.Any(item => item.Decision is not null || !IsActiveConversationRunning))
                    {
                        <section class="approval-history" aria-label="Permission history">
                            <h3>Permission history</h3>
                            @foreach (var approval in _approvalHistory.Where(item => item.Decision is not null || !IsActiveConversationRunning))
                            {
                                <article class="approval-history-item">
                                    <div class="approval-history-title">
                                        <strong>@approval.ToolName</strong>
                                        <span>@ApprovalHistoryStatus(approval)</span>
                                    </div>
                                    <p>@approval.Summary</p>
                                    @if (!string.IsNullOrWhiteSpace(approval.Detail))
                                    {
                                        <details>
                                            <summary>Review what was requested</summary>
                                            <pre>@approval.Detail</pre>
                                        </details>
                                    }
                                </article>
                            }
                        </section>
                    }

                    @if (_streaming)
                    {
                        <article class="msg">
                            <span class="msg-who">Concierge</span>
                            <div class="msg-body"><AssistantContent Content="@_streamingBuffer" /></div>
                        </article>
                    }

                    @*
                        Permission, where the run stopped — the live request
                        from the tool loop, rendered as the last thing in the
                        stream. The sidebar's Approvals group is the standing
                        overview; this is the one actually blocking work, and
                        it belongs in the conversation rather than appended to
                        the end of it from a separate list.
                    *@
                    <ApprovalPrompt />
                </div>
            </div>
        }

        <div class="comp">
            <div class="comp-inner">
                @if (_pendingAttachments.Count > 0)
                {
                    <div class="chips">
                        @foreach (var attachment in _pendingAttachments)
                        {
                            var att = attachment;
                            <button class="chip" type="button" @onclick="@(() => RemoveAttachment(att))">
                                <span class="chip-what">@att.FileName</span>
                                <span class="chip-more">×</span>
                            </button>
                        }
                    </div>
                }


                @*
                    What it said it would do, while it is still doing it.
                    Placed above the composer rather than in the thread: it is
                    a live view of the run, not something that was said, and
                    the moment to stop it is the moment you are reading it.
                *@
                @if (IsActiveConversationRunning && _activeRuntime is IChatRuntimeStatusEvents)
                {
                    <div class="run-recovery" role="status">Working on this device · @(_streamingBuffer.Length == 0 ? "Waiting for first response" : "Receiving answer") · @RunElapsed · @_activeRuntime.StatusMessage</div>
                }
                else if (_runRecoveryStatus is not null)
                {
                    <div class="run-recovery" role="status">@_runRecoveryStatus</div>
                }
                @if (_planSteps.Count > 0)
                {
                    <div class="plan">
                        <span class="plan-head">
                            Plan
                            <span class="plan-count">@_planDone of @_planSteps.Count</span>
                        </span>
                        <ol class="plan-steps">
                            @for (var i = 0; i < _planSteps.Count; i++)
                            {
                                var done = i < _planDone;
                                var current = i == _planDone && _streaming;

                                <li class="plan-step @(done ? "is-done" : null) @(current ? "is-now" : null)">
                                    <span class="dot @(done ? "dot-done" : current ? "dot-waiting" : "dot-idle")" aria-hidden="true"></span>
                                    @_planSteps[i]
                                </li>
                            }
                        </ol>
                    </div>
                }
                @* "Ask me anything" while a canvas is open asks for something that
                   is not going to happen — nothing is being asked and no model is
                   answering. *@
                <div class="comp-box">
                    <textarea class="comp-input"
                              disabled="@(!WorkspaceReady)"
                              rows="1"
                              placeholder="@CanvasInvitation"
                              @bind="_composerText"
                              @bind:event="oninput"
                              @bind:after="OnComposerChangedAsync"></textarea>

                    @*
                        Hidden while the canvas was open, because attaching went to
                        the next chat turn and with Design open there is no next
                        chat turn — it looked like it worked and did nothing. It
                        does something now: a picture chosen here goes onto the
                        page, which is the only way to put a real one in a design.
                    *@
                    <label class="icon-btn"
                           title="@(_designOpen ? "Put a picture on the page" : "Attach a file or a picture")">
                        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#cm-icon-file"/></svg>
                        <span class="sr">@(_designOpen ? "Put a picture on the page" : "Attach a file or a picture")</span>
                        <InputFile OnChange="OnAttachmentSelected" class="file-over"
                                   disabled="@(!WorkspaceReady)"
                                   accept=".txt,.md,.markdown,.json,.cs,.razor,.xml,.yaml,.yml,.toml,.csv,.log,.png,.jpg,.jpeg,.gif,.webp" />
                    </label>

                    <button class="icon-btn @(_recording ? "is-on" : null)" type="button"
                            title="@(_recording ? "Stop recording" : "Speak")"
                            disabled="@(!WorkspaceReady)"
                            @onclick="ToggleMicAsync">
                        @if (_recording)
                        {
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#cm-icon-mic"/></svg>
                        }
                        <span class="sr">@(_recording ? "Stop recording" : "Speak")</span>
                    </button>

                    @* type=button, and one handler now. It had @onclick and
                       @onpointerup both, so a single press sent twice; the claim
                       behind the pairing was measured on the Android head and did
                       not hold — fourteen taps, none dropped. type=button still
                       earns its place: without it this submits the form. *@
                    @if (IsActiveConversationRunning)
                    {
                        <button class="icon-btn icon-btn-stop" type="button"
                                title="Stop this run" aria-label="Stop this run" @onclick="StopActiveRun">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                        </button>
                    }
                    <button class="icon-btn icon-btn-send" type="button"
                            aria-disabled="@(!WorkspaceReady || !CanSend ? "true" : "false")" disabled="@(!WorkspaceReady || !CanSend)"
                            title="Send" @onclick="SendAsync">
                        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="#cm-icon-send"/></svg>
                        <span class="sr">Send</span>
                    </button>
                </div>

                @* Codex puts exactly these two under the input. Both were
                   screens in Concierge. *@
                @if (_activeSkillIds.Count > 0)
                {
                    @* Beside the input, because they change every reply that
                       leaves it — the same reason the model name is here. *@
                    <div class="chips">
                        @foreach (var skill in State.GetSkills().Where(s => _activeSkillIds.Contains(s.Id)))
                        {
                            var activeId = skill.Id;
                            <button class="chip" type="button" title="Turn off"
                                    @onclick="@(() => DeactivateSkill(activeId))">
                                <span class="dot dot-done" aria-hidden="true"></span>
                                <span class="chip-what">@skill.Name</span>
                                <span class="chip-more">×</span>
                            </button>
                        }
                    </div>
                }

                <div class="comp-controls">
                    @* A checkbox renders Windows' own blue tick box, which
                       belongs to no design system. Codex uses a switch. *@
                    @*
                        Three choices, not a switch. A switch has two states and
                        this has three, and the two it used to show were both
                        mislabelled: off meant tools never ran rather than that
                        it asked, and on still asked before every write.
                    *@
                    @*
                        The permission modes and the engine name are both about a model
                        answering, and with the canvas open none is. Worse than useless:
                        the row said "Ask first" while Design deliberately acts without
                        asking, so it advertised the opposite of what was happening.
                    *@
                    @if (!_designOpen)
                    {
                    <div class="seg" role="group" aria-label="What it may do">
                        @foreach (var mode in new[]
                        {
                            Concierge.Shared.Tools.ToolPermissionMode.PlanOnly,
                            Concierge.Shared.Tools.ToolPermissionMode.AskFirst,
                            Concierge.Shared.Tools.ToolPermissionMode.ActFreely,
                        })
                        {
                            var choice = mode;
                            <button class="seg-opt @(_permission == choice ? "is-on" : null)"
                                    type="button"
                                    title="@choice.Explain()"
                                    aria-pressed="@(_permission == choice ? "true" : "false")"
                                    @onclick="@(() => SetPermission(choice))">@choice.Label()</button>
                        }
                    </div>
                    <span class="comp-sep">·</span>
                    <span>Circle AI</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_composerHint))
                    {
                        <span class="comp-sep">·</span>
                        <span>@_composerHint</span>
                    }
                    @if (!_designOpen && CurrentModelDownload is { } modelProgress)
                    {
                        <span class="runtime-readiness model-download-status" role="status" aria-live="polite">
                            <span class="model-download-description">@modelProgress.Description</span>
                            <progress max="1" value="@Math.Clamp(modelProgress.Ratio, 0, 1)" aria-label="Circle AI model download progress"></progress>
                            <span class="model-download-percent">@((int)Math.Round(Math.Clamp(modelProgress.Ratio, 0, 1) * 100))%</span>
                            <button class="download-model-action download-model-cancel" type="button" @onclick="CancelModelPreparationAsync">Stop download</button>
                        </span>
                    }
                    else if (!_designOpen && _downloading)
                    {
                        <span class="runtime-readiness model-download-status" role="status" aria-live="polite">
                            <span class="runtime-preparing-bar" role="progressbar" aria-label="Circle AI model preparation progress" aria-valuetext="Preparing; percentage unavailable."></span>
                            @(_downloadDetail ?? "Preparing Circle AI on this device…")
                            <span class="runtime-progress-note">Progress percentage is not available yet.</span>
                        </span>
                    }
                    else if (!_designOpen && PendingModel is { } pendingModel)
                    {
                        <span class="runtime-readiness" role="status">
                            @if (ModelDownloadRecoveryMessage is { } recoveryMessage)
                            {
                                <span class="runtime-readiness-detail">@recoveryMessage</span>
                            }
                            <DownloadOfferSummary Download="pendingModel" LocalCanAnswer="@(_activeRuntime?.IsReady == true)" DeviceName="device" />
                            @if (!pendingModel.FitsThisDevice)
                            {
                                <span>This model may not run smoothly on this device.</span>
                            }
                            <button class="download-model-action" type="button" @onclick="AcceptDownload">
                                @(_activeRuntime?.IsReady == true ? "Prepare offline models" : "Download on this device")
                            </button>
                        </span>
                    }
                    else if (!_designOpen && ModelDownloadRecoveryMessage is { } recoveryMessage)
                    {
                        <span class="runtime-readiness" role="status" aria-live="polite">
                            @recoveryMessage
                        </span>
                    }
                    else if (RuntimeReadinessMessage is { } readinessMessage)
                    {
                        <span class="runtime-readiness" role="status" aria-live="polite">
                            @if (CircleAiIsPreparing)
                            {
                                <span class="runtime-readiness-progress">
                                    <span class="runtime-preparing-bar" role="progressbar" aria-label="Circle AI preparation progress" aria-valuetext="Preparing; percentage unavailable."></span>
                                    <span>@CircleAiPreparationMessage</span>
                                    <span class="runtime-progress-note">This step does not report a percentage.</span>
                                </span>
                            }
                            @if (!CircleAiIsPreparing)
                            {
                                <span>@readinessMessage</span>
                            }
                        </span>
                    }
                </div>
                <ModelSetupTutorial Show="@(!_designOpen && (_downloading || CurrentModelDownload is not null))"
                                    Busy="@(_downloading || CurrentModelDownload is not null)"
                                    Step="@_setupTutorialStep"
                                    Collapsed="@_setupTutorialCollapsed"
                                    OnStepChanged="SetSetupTutorialStepAsync"
                                    OnCollapsedChanged="SetSetupTutorialCollapsedAsync"
                                    OnPromptSelected="UseStarterPrompt" />
            </div>
        </div>
    </main>

    @if (_settingsOpen)
    {
        <Settings OnClose="@(() => _settingsOpen = false)" />
    }

    @if (_showSkillPicker)
    {
        <Skills OnCatalogueChanged="StateHasChanged"
                ActiveIds="_activeSkillIds"
                OnToggle="ToggleSkill"
                OnClose="ToggleSkillPicker" />
    }
</div>

@code {
    private string ProjectOverviewHref()
    {
        if (_turnProject is null)
            return "/projects";

        var query = $"project={_turnProject.Id}";
        if (_active is not null)
            query += $"&conversation={_active.Id}";
        if (_turnProjectWorkspace is not null)
            query += $"&workspace={_turnProjectWorkspace.Id}";
        return $"/projects?{query}";
    }

    private static string ProjectStatusLabel(Concierge.Shared.Planning.ProjectStatus status) => status switch
    {
        Concierge.Shared.Planning.ProjectStatus.Planning => "Planning",
        Concierge.Shared.Planning.ProjectStatus.Active => "In progress",
        Concierge.Shared.Planning.ProjectStatus.Blocked => "Blocked",
        Concierge.Shared.Planning.ProjectStatus.AwaitingPerson => "Needs you",
        Concierge.Shared.Planning.ProjectStatus.Review => "Ready to review",
        Concierge.Shared.Planning.ProjectStatus.Completed => "Complete",
        Concierge.Shared.Planning.ProjectStatus.Archived => "Archived",
        _ => "In progress"
    };

    private static string ProjectStatusKey(Concierge.Shared.Planning.ProjectStatus status)
        => status.ToString().ToLowerInvariant();

    private static string ProjectWorkStatusLabel(Concierge.Shared.Planning.ProjectWorkStatus status) => status switch
    {
        Concierge.Shared.Planning.ProjectWorkStatus.Planned => "Planned",
        Concierge.Shared.Planning.ProjectWorkStatus.Active => "In progress",
        Concierge.Shared.Planning.ProjectWorkStatus.Blocked => "Blocked",
        Concierge.Shared.Planning.ProjectWorkStatus.AwaitingPerson => "Needs you",
        Concierge.Shared.Planning.ProjectWorkStatus.Review => "Ready to review",
        Concierge.Shared.Planning.ProjectWorkStatus.Completed => "Complete",
        Concierge.Shared.Planning.ProjectWorkStatus.Skipped => "Skipped",
        _ => "Planned"
    };

    private static string ProjectWorkStatusKey(Concierge.Shared.Planning.ProjectWorkStatus status)
        => status.ToString().ToLowerInvariant();

    private string ConversationStatusText(int openApprovals)
    {
        if (openApprovals > 0)
            return "Needs your OK";
        if (IsActiveConversationRunning)
            return "Concierge is working in this conversation";
        if (_runRecoveryStatus is not null)
            return string.Equals(_latestRunReceipt?.Status, "failed", StringComparison.OrdinalIgnoreCase)
                ? "Last run failed · review the conversation"
                : string.Equals(_latestRunReceipt?.Status, "cancelled", StringComparison.OrdinalIgnoreCase)
                    ? "Last run was stopped · review the conversation"
                    : "Run did not complete · review the conversation";
        if (string.Equals(_latestRunReceipt?.Status, "completed", StringComparison.OrdinalIgnoreCase))
            return "Last run completed · result is in this conversation";
        return "Conversation ready to continue";
    }
}
