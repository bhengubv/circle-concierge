@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IConciergeStateService State
@inject IServiceProvider Services
@inject IJSRuntime JS

@*
    The shell is a frame and nothing else.

    It used to carry a top bar with a brand and a ⋯ menu, and then a five-tab
    bottom navigation bar. Neither reference has either: Codex has a sidebar,
    Claude Design has modes. Concierge is one workspace now, and the workspace
    draws its own sidebar — so the only thing left for a layout to do is hold
    the page.

    The permission prompt used to live here, above everything, as a modal. It
    has moved into the thread: a run stops in the middle of doing something,
    and covering the work to ask about it hides the context the answer depends
    on. It is now the last thing in the conversation, which is where the run
    actually stopped.
*@

<CircleIconSprite />
@Body

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    private Concierge.Shared.Devices.IDesktopSummon? _summon;
    private bool _focusAfterRender;
    protected override void OnInitialized()
    {
        _summon = Services.GetService(typeof(Concierge.Shared.Devices.IDesktopSummon)) as Concierge.Shared.Devices.IDesktopSummon;
        if (_summon is not null) _summon.Summoned += Summon;
    }
    private async void Summon()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _focusAfterRender = true;
                var path = Nav.ToBaseRelativePath(Nav.Uri);
                if (path.Length > 0 && !path.StartsWith("chat", StringComparison.OrdinalIgnoreCase)) Nav.NavigateTo("/chat");
                StateHasChanged();
            });
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { /* Native activation still succeeds if the web view is not ready. */ }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusAfterRender) return;
        _focusAfterRender = false;
        try { await JS.InvokeVoidAsync("conciergeThread.focusComposer"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { /* A later summon can retry after the web view becomes ready. */ }
    }
    public void Dispose()
    {
        if (_summon is not null) _summon.Summoned -= Summon;
    }
}
