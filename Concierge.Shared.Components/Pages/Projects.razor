    private IReadOnlyList<ProjectAgentEvent> AgentEventsFor(Guid runId)
        => _agentEvents.TryGetValue(runId, out var events) ? events : [];

    private async Task ReadNewAgentEventsAsync(ConciergeProject project)
    {
        foreach (var run in project.AgentRuns)
        {
            var cursor = _agentEventCursors.TryGetValue(run.Id, out var sequence) ? sequence : -1;
            var updates = await ProjectStore.ReadAgentEventsAsync(project.Id, run.Id, cursor);
            if (updates.Count == 0)
                continue;
            if (!_agentEvents.TryGetValue(run.Id, out var events))
                _agentEvents[run.Id] = events = [];
            events.AddRange(updates);
            if (events.Count > 100)
                events.RemoveRange(0, events.Count - 100);
            _agentEventCursors[run.Id] = updates[^1].Sequence;
        }
    }

