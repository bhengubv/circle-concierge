    private async Task WithSaving(Func<Task> action)
    {
        _saving = true;
        _error = null;
        try
        {
            await action();
        }
        catch (ProjectRevisionConflictException conflict)
        {
            _error = conflict.Message;
            _projects = (await ProjectStore.ListAsync()).ToList();
            _selected = await ProjectStore.GetAsync(conflict.ProjectId);
        }
        catch (StartupJourneyRevisionConflictException conflict)
        {
            _error = conflict.Message;
            _startups = (await ProjectStore.ListStartupsAsync()).ToList();
            _selectedStartup = await ProjectStore.GetStartupAsync(conflict.JourneyId);
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException or ArgumentException)
        {
            _error = exception.Message;
        }
        finally
        {
            _saving = false;
        }
    }
