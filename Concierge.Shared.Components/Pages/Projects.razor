    private bool WouldCreateDependencyCycle(ProjectStep editedStep, ProjectStep proposedDependency)
    {
        if (_selected is null) return false;
        var steps = _selected.Workflows.SelectMany(workflow => workflow.Steps).ToDictionary(step => step.Id);
        var visited = new HashSet<Guid>();

        bool ReachesEditedStep(ProjectStep current)
        {
            if (current.Id == editedStep.Id) return true;
            if (!visited.Add(current.Id)) return false;
            return current.DependsOn.Any(dependencyId =>
                steps.TryGetValue(dependencyId, out var dependency) && ReachesEditedStep(dependency));
        }

        return ReachesEditedStep(proposedDependency);
    }

