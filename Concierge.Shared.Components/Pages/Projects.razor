    private static bool IsButlerTerminal(string status)
        => status.Equals("completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("failed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("cancelled", StringComparison.OrdinalIgnoreCase);

    private static string ButlerStatusLabel(string status) => status switch
    {
        "dispatch_pending" => "Starting with Butler",
        "cancellation_requested" => "Stopping",
        _ => status,
    };

    private async Task RefreshButlerRunAsync(Guid projectRunId)
    {
        if (_selected is null || !_refreshingButlerIds.Add(projectRunId)) return;
        var projectId = _selected.Id;
        try
        {
            var tracked = _selected.ButlerRuns.SingleOrDefault(run => run.Id == projectRunId);
            if (tracked is null) return;
            if (tracked.ButlerRunId == Guid.Empty) return;
            var butlerRunId = tracked.ButlerRunId;
            var envelope = await ButlerRunsApi.GetRunAsync(butlerRunId);
            var events = await ButlerRunsApi.ReadEventsAsync(butlerRunId, tracked.LastEventSequence);
            await SaveProjectAsync(project => project.Id != projectId ? project : project with
            {
                ButlerRuns = project.ButlerRuns.Select(run => run.Id == projectRunId
                    ? run with
                    {
                        Status = envelope.Run.Status,
                        CancellationRequested = envelope.Run.CancellationRequested,
                        Problem = envelope.Run.Problem,
                        ResultJson = envelope.Run.Result?.GetRawText(),
                        LastEventSequence = events.Count == 0 ? run.LastEventSequence : Math.Max(run.LastEventSequence, events.Max(item => item.Sequence)),
                        Events = MergeButlerEvents(run.Events, events),
                        UpdatedAt = DateTimeOffset.UtcNow,
                    }
                    : run).ToArray(),
            });
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or IOException)
        {
            _error = $"Could not refresh Butler's run: {exception.Message}";
        }
        finally
        {
            _refreshingButlerIds.Remove(projectRunId);
        }
    }

    private async Task CancelButlerRunAsync(Guid projectRunId)
    {
        if (_selected is null || !_refreshingButlerIds.Add(projectRunId)) return;
        try
        {
            var tracked = _selected.ButlerRuns.SingleOrDefault(run => run.Id == projectRunId);
            if (tracked is null) return;
            var accepted = tracked.ButlerRunId == Guid.Empty
                ? true
                : await ButlerRunsApi.CancelAsync(tracked.ButlerRunId);
            await SaveProjectAsync(project => project with
            {
                ButlerRuns = project.ButlerRuns.Select(run => run.Id == projectRunId
                    ? run with
                    {
                        Status = accepted ? (run.ButlerRunId == Guid.Empty ? "dispatch_pending" : "cancellation_requested") : run.Status,
                        CancellationRequested = accepted || run.CancellationRequested,
                        UpdatedAt = DateTimeOffset.UtcNow,
                    }
                    : run).ToArray(),
            });
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or IOException)
        {
            _error = $"Could not request Butler cancellation: {exception.Message}";
        }
        finally
        {
            _refreshingButlerIds.Remove(projectRunId);
        }
    }

    private static IReadOnlyList<ProjectButlerEvent> MergeButlerEvents(IReadOnlyList<ProjectButlerEvent> current,
        IReadOnlyList<ButlerWorkRunEvent> updates)
    {
        var events = current.ToDictionary(item => item.Sequence);
        foreach (var item in updates)
            events[item.Sequence] = new ProjectButlerEvent(item.Sequence, item.Type, item.Data.GetRawText(), item.CreatedAt);
        return events.Values.OrderBy(item => item.Sequence).ToArray();
    }

