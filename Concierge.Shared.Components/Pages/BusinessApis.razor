@page "/business-apis"
@inject IScalarApiService ScalarApi
@inject IMediaStudioService MediaStudio

@{
    var scalar = ScalarApi.GetSnapshot();
    var media = MediaStudio.GetSnapshot();
}

<section class="page-header">
    <p class="eyebrow">Business APIs</p>
    <h1>Connect the tools businesses actually use.</h1>
    <p class="lede">The rebuilt catalog keeps Western, African, Asian, and BRICS+ integrations in view without forcing one platform.</p>
</section>

<section class="card-grid">
    @foreach (var group in Groups)
    {
        <article class="surface-card">
            <strong>@group.Name</strong>
            <span>@group.Examples</span>
            <p>@group.Summary</p>
        </article>
    }
</section>

<section class="page-header">
    <p class="eyebrow">Built in</p>
    <h1>API Room with Scalar-style workflows.</h1>
    <p class="lede">Concierge can render API references, validate OpenAPI files, prepare safe test requests, generate examples, create mocks, and let an agent explain API contracts in plain language.</p>
</section>

<section class="metric-grid">
    <div class="metric"><strong>@scalar.Capabilities.Count</strong><span>API capabilities</span></div>
    <div class="metric"><strong>@scalar.Templates.Count</strong><span>starter workflows</span></div>
    <div class="metric"><strong>@scalar.License</strong><span>license</span></div>
    <div class="metric"><strong>Optional</strong><span>external tooling</span></div>
</section>

<section class="card-grid">
    @foreach (var capability in scalar.Capabilities)
    {
        <article class="surface-card ready">
            <strong>@capability.Name</strong>
            <span>@capability.Kind - built in by default: @(capability.BuiltInByDefault ? "yes" : "no")</span>
            <p>@capability.ConciergeUse</p>
            <p><b>Safety:</b> @capability.SafetyBoundary</p>
        </article>
    }
</section>

<section class="page-header">
    <p class="eyebrow">Media studio</p>
    <h1>Aether Media library lives next to the API rooms.</h1>
    <p class="lede">@media.Summary</p>
</section>

<section class="metric-grid">
    <div class="metric"><strong>@media.Engine</strong><span>engine</span></div>
    <div class="metric"><strong>v@(media.EngineVersion)</strong><span>version</span></div>
    <div class="metric"><strong>@media.LibraryItemCount</strong><span>library items</span></div>
    <div class="metric"><strong>@string.Join(" / ", media.SupportedKinds)</strong><span>kinds</span></div>
</section>

<section class="card-grid">
    @foreach (var item in media.RecentItems)
    {
        <article class="surface-card">
            <strong>@item.Title</strong>
            <span>@item.ContentType - @item.FormattedDuration</span>
            <p>By @item.CreatorTag. Codec: @item.Codec.</p>
            @if (item.Tags.Count > 0)
            {
                <p><b>Tags:</b> @string.Join(", ", item.Tags)</p>
            }
        </article>
    }
</section>

@code {
    private static readonly (string Name, string Examples, string Summary)[] Groups =
    [
        ("Social and messaging", "Meta, WhatsApp, X, LinkedIn, Kakao, WeChat", "Reach customers and route conversations into support, sales, and campaigns."),
        ("Commerce", "Shopify, WooCommerce, AliExpress, Taobao", "Keep storefronts, marketplace actions, products, and orders connected."),
        ("Finance", "Xero, Stripe, PayPal, bank feeds", "Track money, invoices, payments, reconciliation, and evidence."),
        ("Logistics", "DHL, FedEx, Parcel Ninja, local couriers", "Turn orders into delivery workflows and customer updates."),
        ("Productivity", "Microsoft Graph, Google Workspace, Slack, Notion", "Keep files, notes, meetings, and operating rhythm connected.")
    ];
}
