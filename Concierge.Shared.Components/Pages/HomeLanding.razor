@page "/"
@page "/home"

<main class="cm-home" aria-labelledby="cm-home-title">
    <div class="cm-home-heading">
        <p class="cm-home-eyebrow">CONCIERGE BY CIRCLE</p>
        <h1 id="cm-home-title">What shall we make happen?</h1>
        <p>Start with a thought. We'll help you turn it into work you can see.</p>
    </div>

    <nav class="cm-home-grid" aria-label="Start with Concierge">
        <a class="cm-home-tile cm-home-talk" href="/chat">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-message" /></svg>
            <strong>Chats</strong><span>Ask, explore, decide.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cm-home-tile cm-home-notes" href="/notes">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-edit" /></svg>
            <strong>Notes</strong><span>Write and collect your thoughts.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cm-home-tile cm-home-studio" href="/studio">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-apps" /></svg>
            <strong>Studio</strong><span>Build and manage projects.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cm-home-tile cm-home-library" href="/library">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-file" /></svg>
            <strong>Library</strong><span>Pick up where you left off.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cm-home-tile cm-home-tutorials" href="/tutorials">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-check" /></svg>
            <strong>Tutorials</strong><span>Learn one step at a time.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="cm-home-tile cm-home-demos" href="/demos">
            <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#cm-icon-star" /></svg>
            <strong>Demos</strong><span>See what you can make.</span>
            <span class="cm-home-arrow" aria-hidden="true">↗</span>
        </a>
    </nav>
    <p class="cm-home-note">Your drafts stay on your device until you choose to share them.</p>
</main>
