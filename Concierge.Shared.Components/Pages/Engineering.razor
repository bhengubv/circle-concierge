@page "/engineering"
@inject IAgentHarnessService Harness
@inject IServiceProvider Services

@*
    Engineering: the tools Concierge can actually run, and what each one is
    allowed to do.

    This is the room that earns trust, so it is written to be checked rather
    than believed — which is exactly what it was not doing. It listed five
    hand-written names from IAgentHarnessService.GetTools(), and the model was
    given a different set: two of the five (list_files, grep) are not tools it
    can call at all, one is under another name, and web_fetch, web_search and
    both notebook tools were missing entirely. A room whose whole job is
    telling you what can happen to your machine was answering from a list
    nobody had updated since the catalogue grew.

    It now reads the registry the model is actually handed. If a tool is here,
    the model can call it; if it is not here, it cannot.
*@

@{
    var tools = BuiltIn();
    var logs = Harness.GetRunLogs();
}

<div class="room">
    <div class="room-top">
        <a class="room-back" href="/">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg>
            Workspace
        </a>
        <h1>Engineering</h1>
    </div>

    <p class="room-lede">
        What Concierge can do to your machine, tool by tool. Anything that can change
        or destroy something asks first — this room is where you check that claim.
    </p>

    <div class="room-body">
        <RoomSection Title="Working in" Open="true">
            <div class="rows">
                <div class="row">
                    <span class="row-name">Workspace root</span>
                    <span class="row-val">@Harness.WorkspaceRoot</span>
                </div>
                <div class="row">
                    <span class="row-name">Tools available</span>
                    <span class="row-val">@tools.Count</span>
                </div>
            </div>
            <p class="room-note">Nothing outside that folder is reachable by a file tool.</p>

            @*
                What a command is confined by, in the platform's own words. The room
                claims to say what Concierge can do to your machine, and until now
                it said nothing at all about the one tool that starts processes.
            *@
            <div class="rows">
                <div class="row">
                    <span class="row-name">
                        Commands run
                        <span class="row-sub">@Harness.Confinement.Explanation</span>
                    </span>
                    <span class="state">
                        <span class="dot @(Harness.Confinement.Strength == Concierge.Shared.Sandboxing.SandboxStrength.None ? "dot-danger" : "dot-waiting")" aria-hidden="true"></span>
                        @(Harness.Confinement.Strength switch
                        {
                            Concierge.Shared.Sandboxing.SandboxStrength.Confined => "Confined",
                            Concierge.Shared.Sandboxing.SandboxStrength.Process => "Capped and killed with the app",
                            _ => "Not confined",
                        })
                    </span>
                </div>

                @*
                    The encoder, because eight tools and design_save are absent without
                    one and this is the room where somebody finds out why.

                    It also says what it is rather than only that it exists, and on one
                    head that matters legally as well as practically: everywhere else
                    ffmpeg is somebody else's install found on the machine, and on
                    Android it ships inside the app — the first thing this product
                    redistributes rather than finds. LGPL, so it has to be named.
                *@
                <div class="row">
                    <span class="row-name">
                        Media read and written
                        <span class="row-sub">
                            @(Concierge.Shared.Design.Encoders.Here
                                ? Concierge.Shared.Design.Encoders.Runner.What
                                : "Without one, nothing can read a media file or save a design as one.")
                        </span>
                    </span>
                    <span class="state">
                        <span class="dot @(Concierge.Shared.Design.Encoders.Here ? "dot-done" : "dot-danger")" aria-hidden="true"></span>
                        @(Concierge.Shared.Design.Encoders.Here ? "With an encoder" : "No encoder")
                    </span>
                </div>
            </div>
        </RoomSection>

        <RoomSection Title="Reads only" Count="@tools.Count(t => t.IsReadOnly)">
            <div class="rows">
                @foreach (var tool in tools.Where(t => t.IsReadOnly))
                {
                    <div class="row">
                        <span class="row-name">
                            @tool.Name
                            <span class="row-sub">@tool.Description</span>
                        </span>
                        <span class="state"><span class="dot dot-done" aria-hidden="true"></span>Safe</span>
                    </div>
                }
            </div>
        </RoomSection>

        <RoomSection Title="Can change things" Count="@tools.Count(t => !t.IsReadOnly)">
            <div class="rows">
                @foreach (var tool in tools.Where(t => !t.IsReadOnly))
                {
                    <div class="row">
                        <span class="row-name">
                            @tool.Name
                            <span class="row-sub">@tool.Description</span>
                        </span>
                        <span class="state">
                            <span class="dot dot-waiting" aria-hidden="true"></span>
                            Asks first
                        </span>
                    </div>
                }
            </div>
        </RoomSection>

        @*
            How rooms get drawn.

            The same argument as "Not on this device", and the reason it is in
            this room. Space draws the flat room first and lets the 3D engine
            replace it, so a machine that cannot run the engine shows a room that
            works perfectly and says nothing — which is right for the person using
            it and useless for the person wondering why theirs looks flatter than
            somebody else's. This is where you check which you are in.
        *@
        <RoomSection Title="Rooms in three dimensions">
            @if (_scene is null)
            {
                <p class="room-note">Not available in this build.</p>
            }
            else
            {
                <div class="row">
                    <span class="row-name">Space</span>
                    <span class="state">
                        <span class="dot @(_scene.Last.By switch
                                          {
                                              Concierge.Shared.Design.SceneDrawnBy.Engine => "dot-on",
                                              Concierge.Shared.Design.SceneDrawnBy.Fallback => "dot-off",
                                              _ => "dot-waiting",
                                          })" aria-hidden="true"></span>
                        @(_scene.Last.By switch
                        {
                            Concierge.Shared.Design.SceneDrawnBy.Engine => "With a 3D engine",
                            Concierge.Shared.Design.SceneDrawnBy.Fallback => "Flat",
                            _ => "Not tried yet",
                        })
                    </span>
                </div>

                <p class="room-note">@_scene.Sentence</p>
            }
        </RoomSection>

        @*
            What this device cannot do.

            The model is never told about these — an unavailable capability is
            absent from its catalogue, which is the whole design. A person is a
            different matter: "why won't it text from my laptop" deserves an
            answer, and silence is not one.
        *@
        @if (_unavailable.Count > 0)
        {
            <RoomSection Title="Not on this device" Count="@_unavailable.Count">
                <div class="rows">
                    @foreach (var capability in _unavailable)
                    {
                        <div class="row">
                            <span class="row-name">
                                @capability.Name
                                <span class="row-sub">@capability.Description</span>
                            </span>
                            <span class="state">
                                <span class="dot dot-idle" aria-hidden="true"></span>
                                Not available here
                            </span>
                        </div>
                    }
                </div>
                <p class="room-note">
                    Concierge is never offered these on this device, so it will not try them.
                </p>
            </RoomSection>
        }

        @*
            Programs the person registered to run in front of tool calls.

            Beside the MCP servers because they are the same kind of thing — other
            software this machine's owner chose to let in — and separate from the
            tool list because a hook is not a tool: nothing calls it, it calls
            nothing, and it can refuse things the rest of the list can do.

            Shown even when empty. "No hooks" and "hooks I have forgotten about"
            look identical from the outside, and this is the room where somebody
            checks which they are in.
        *@
        <RoomSection Title="Hooks you registered" Count="@_hooks.Count">
            @if (_hookStatus is null)
            {
                <p class="room-note">Not available in this build.</p>
            }
            else
            {
                @if (_hooks.Count == 0)
                {
                    <p class="room-note">
                        None. Nothing runs in front of a tool call unless you write it here.
                    </p>
                }
                else
                {
                    <div class="rows">
                        @foreach (var hook in _hooks)
                        {
                            <div class="row">
                                <span class="row-name">
                                    @hook.Command
                                    <span class="row-sub">@string.Join(' ', hook.Arguments)</span>
                                </span>
                                <span class="state">
                                    <span class="dot dot-waiting" aria-hidden="true"></span>
                                    @(hook.Event switch
                                    {
                                        Concierge.Shared.Hooks.HookEvent.PreToolUse => "Before a tool — can refuse it",
                                        Concierge.Shared.Hooks.HookEvent.PostToolUse => "After a tool",
                                        Concierge.Shared.Hooks.HookEvent.UserPromptSubmit => "When you send something",
                                        _ => "When a turn finishes",
                                    })
                                </span>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_hookStatus.Problem))
                {
                    <p class="room-note">@_hookStatus.Problem</p>
                }

                <p class="room-note">@_hookStatus.Path</p>
            }
        </RoomSection>

        @*
            Tools from other software. Listed apart from the built-in ones
            because the trust is different: these arrive over a protocol that
            says nothing about what they do, so every one asks before it runs.
        *@
        <RoomSection Title="From other software" Count="@_servers.Count">
            @if (_mcp is null)
            {
                <p class="room-note">Not available in this build.</p>
            }
            else if (_servers.Count == 0)
            {
                <p class="room-note">
                    No MCP servers are set up. Add them in @_mcp.ConfigPath and restart.
                </p>
            }
            else
            {
                <div class="rows">
                    @foreach (var server in _servers)
                    {
                        <div class="row">
                            <span class="row-name">
                                @server.Name
                                <span class="row-sub">@server.Status</span>
                                @if (server.ToolNames is { Count: > 0 })
                                {
                                    @* What it can do, not just that it is alive. *@
                                    <span class="row-sub">@string.Join(", ", server.ToolNames)</span>
                                }
                            </span>
                            <span class="state">
                                <span class="dot @(server.Connected ? "dot-done" : "dot-waiting")" aria-hidden="true"></span>
                                @(server.Connected ? (server.ToolCount == 1 ? "1 tool" : $"{server.ToolCount} tools") : "Not connected")
                            </span>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_mcp.ConfigProblem))
                {
                    <p class="room-note">@_mcp.ConfigProblem</p>
                }

                <p class="room-note">
                    Every one of these asks before it runs. Configured in @_mcp.ConfigPath
                </p>
            }
        </RoomSection>

        <RoomSection Title="Recent runs" Count="@logs.Count">
            @if (logs.Count == 0)
            {
                <p class="room-note">Nothing has run yet.</p>
            }
            else
            {
                <div class="rows">
                    @foreach (var log in logs.Take(8))
                    {
                        <div class="row">
                            <span class="row-name">
                                @log.Goal
                                <span class="row-sub">@log.Results.Count tool calls</span>
                            </span>
                            <span class="row-val">@log.CreatedAt.ToLocalTime().ToString("d MMM HH:mm")</span>
                        </div>
                    }
                </div>
            }
        </RoomSection>
    </div>
</div>

@code {
    // Resolved rather than injected: a host that has not called AddConciergeMcp
    // should render this room, not fail to.
    private Concierge.Shared.Rpc.Mcp.McpToolSource? _mcp;
    private IReadOnlyList<Concierge.Shared.Rpc.Mcp.McpServerStatus> _servers = [];

    // Same reason: a host that wired no registry should render this room and
    // say so, rather than fail to render at all.
    private Concierge.Shared.Tools.IAgentToolRegistry? _registry;

    private IReadOnlyList<Concierge.Shared.Devices.IDeviceCapability> _unavailable = [];

    /// <summary>
    /// What is registered to run in front of tool calls, and where the file is.
    /// Resolved rather than injected, like the others: a host that has not called
    /// AddConciergeHooks renders the room without the section.
    /// </summary>
    private Concierge.Shared.Hooks.HookStatus? _hookStatus;
    private Concierge.Shared.Design.SceneEngineReport? _scene;

    private IReadOnlyList<Concierge.Shared.Hooks.HookRegistration> _hooks = [];

    protected override void OnInitialized()
    {
        _mcp = Services.GetService(typeof(Concierge.Shared.Rpc.Mcp.McpToolSource))
            as Concierge.Shared.Rpc.Mcp.McpToolSource;

        _servers = _mcp?.Statuses ?? [];

        _registry = Services.GetService(typeof(Concierge.Shared.Tools.IAgentToolRegistry))
            as Concierge.Shared.Tools.IAgentToolRegistry;

        _hookStatus = Services.GetService(typeof(Concierge.Shared.Hooks.HookStatus))
            as Concierge.Shared.Hooks.HookStatus;

        _scene = Services.GetService(typeof(Concierge.Shared.Design.SceneEngineReport))
            as Concierge.Shared.Design.SceneEngineReport;

        _hooks = _hookStatus?.Hooks ?? [];

        // Every source this head wired, asked what it declared but cannot do.
        // Resolved rather than injected, like the others: a head with no device
        // layer renders this room without the section, not without the room.
        _unavailable = (Services.GetService(typeof(IEnumerable<Concierge.Shared.Tools.IAgentToolSource>))
                as IEnumerable<Concierge.Shared.Tools.IAgentToolSource> ?? [])
            .OfType<Concierge.Shared.Devices.DeviceCapabilitySource>()
            .SelectMany(source => source.Declared)
            .Where(declared => !declared.Available)
            .Select(declared => declared.Capability)
            .OrderBy(capability => capability.Name, StringComparer.Ordinal)
            .ToList();
    }

    /// <summary>
    /// Everything the model is handed except what came over MCP, which has its
    /// own section below — the trust is different and listing a remote tool
    /// twice would suggest otherwise.
    /// </summary>
    private IReadOnlyList<Concierge.Shared.Tools.IAgentTool> BuiltIn()
    {
        if (_registry is null)
        {
            return [];
        }

        var remote = _mcp?.Tools.Select(t => t.Name).ToHashSet(StringComparer.Ordinal) ?? [];

        return _registry.Tools.Where(t => !remote.Contains(t.Name)).ToList();
    }
}
