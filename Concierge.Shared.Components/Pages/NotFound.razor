@page "/not-found"

@*
    A dead link, said plainly.

    The old build rendered this outside the shell, so a mistyped address left
    you on a bare page with no way back. It is a room like any other now, which
    means it carries the one thing it actually needs.
*@

<div class="room">
    <div class="room-top">
        <a class="room-back" href="/">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg>
            Workspace
        </a>
        <h1>Not found</h1>
    </div>

    <p class="room-lede">That address does not go anywhere.</p>

    <div class="room-body">
        <RoomSection Title="Try instead" Open="true">
            <div class="rows">
                <a class="row" href="/"><span class="row-name">The workspace<span class="row-sub">Your threads, and the composer</span></span></a>
                <a class="row" href="history"><span class="row-name">History<span class="row-sub">Search everything you have asked</span></span></a>
                <a class="row" href="product"><span class="row-name">Product<span class="row-sub">Where everything else is</span></span></a>
            </div>
        </RoomSection>
    </div>
</div>
