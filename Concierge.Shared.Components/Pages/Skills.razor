@inject ISkillCatalogService SkillCatalog
@inject Concierge.Shared.Skills.UserSkillFolders Folders

@*
    Skills, as something you switch on — not a catalogue you read.

    The machinery was already here: active skill ids compose into the system
    prompt through ISkillRuntime before every turn, so turning one on changes
    what the assistant is for the rest of the conversation. What was missing was
    any way to do it. The old page listed sixty-nine names and did nothing.

    So this is a picker: search, and press to switch on. Sixty-nine of anything
    is a search problem — reading the list is not a plan — and the count of what
    is on matters more than the count of what exists, because that is what is
    shaping the answers.
*@

@{
    var all = SkillCatalog.GetSkills();
    var shown = all
        .Where(s => _filter.Length == 0
                    || s.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                    || s.Area.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                    || s.Summary.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(s => ActiveIds.Contains(s.Id))
        .ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="sheet-back" @onclick="Close" aria-hidden="true"></div>

<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="skills-title">
    <div class="sheet-head">
        <h1 class="sheet-title" id="skills-title">Skills</h1>
        <button class="icon-btn" type="button" title="Close" @onclick="Close">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span class="sr">Close skills</span>
        </button>
    </div>

    <input class="comp-input skills-find"
           type="search"
           placeholder="What do you want it to be good at?"
           aria-label="Search skills"
           value="@_filter"
           @oninput="OnFilterChanged" />

    <div class="sheet-count">
        @if (ActiveIds.Count > 0)
        {
            <span class="state"><span class="dot dot-done" aria-hidden="true"></span>@ActiveIds.Count on</span>
        }
        else
        {
            <span>None on — it answers as itself</span>
        }
        <span class="row-val">@shown.Count of @all.Count</span>
    </div>

    @if (shown.Count == 0)
    {
        <p class="row-sub">Nothing matches “@_filter”.</p>
    }
    else
    {
        @* Five. Measured, not chosen: twelve three-line rows ran the panel
           664px past the bottom of a 479px-tall window; clamping the summary to
           one line and cutting to eight still left 147px hanging. A row is 56px
           and the panel has 460px to spend, most of it on the search field this
           list is really an accessory to. The count above says how many more
           there are, and typing is how you reach them. *@
        <div class="rows skills-list">
            @foreach (var skill in shown.Take(5))
            {
                var id = skill.Id;
                var on = ActiveIds.Contains(id);

                <button class="row skill-row @(on ? "is-on" : null)"
                        type="button"
                        aria-pressed="@(on ? "true" : "false")"
                        @onclick="@(() => OnToggle.InvokeAsync(id))">
                    <span class="row-name">
                        @skill.Name
                        <span class="row-sub">@skill.Summary</span>
                    </span>
                    @if (on)
                    {
                        <span class="state"><span class="dot dot-done" aria-hidden="true"></span>On</span>
                    }
                    else
                    {
                        @* Yours or ours. "Why is it answering like that?" is
                           answered by which skills are on and where they came
                           from, and until now the second half was not shown. *@
                        <span class="row-val">@(skill.Source == "bundled" ? skill.Area : "yours")</span>
                    }
                </button>
            }
        </div>

        @if (shown.Count > 5)
        {
            <p class="row-sub">@(shown.Count - 5) more — keep typing to narrow it down.</p>
        }
    }

    @*
        Your own skills. Until now the only way in was an environment variable
        set before launch, pointing at a folder with three specific subfolder
        names — a developer's arrangement in a product that is not only for
        developers.

        A path to paste rather than a folder picker: this renders in a WebView,
        which has no directory picker, and a native one would have to be passed
        in by each host. Pasting a path is the honest version of that, and the
        folder is checked before it is accepted.
    *@
    <RoomSection Title="Your own skills" Count="@_folders.Count">
        @if (_folders.Count > 0)
        {
            <div class="rows">
                @foreach (var folder in _folders)
                {
                    var path = folder;
                    <div class="row">
                        <span class="row-name">
                            @FolderName(path)
                            <span class="row-sub">@path</span>
                            @if (!Directory.Exists(path))
                            {
                                <span class="row-sub">Not there any more.</span>
                            }
                        </span>
                        <button class="row-val" type="button" style="background:none;border:0;cursor:pointer;"
                                @onclick="@(() => RemoveFolder(path))">Remove</button>
                    </div>
                }
            </div>
        }

        <input class="comp-input"
               type="text"
               placeholder="Paste a folder of skills"
               aria-label="Folder of skills"
               value="@_newFolder"
               @oninput="@(e => _newFolder = e.Value?.ToString() ?? string.Empty)" />

        <button class="btn btn-primary" type="button" disabled="@string.IsNullOrWhiteSpace(_newFolder)"
                @onclick="AddFolder">Add</button>

        @if (!string.IsNullOrWhiteSpace(_folderMessage))
        {
            <p class="room-note">@_folderMessage</p>
        }

        <p class="room-note">A skill is a folder with a SKILL.md in it.</p>
    </RoomSection>
</div>

@code {
    /// <summary>Which skills are on. Owned by the workspace, because they shape
    /// every turn it sends — this panel only offers them.</summary>
    [Parameter, EditorRequired] public IReadOnlyCollection<string> ActiveIds { get; set; } = Array.Empty<string>();

    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>
    /// Raised when the catalogue changes, so the workspace behind this panel
    /// redraws. Without it the sidebar kept saying "Browse all 69" while the
    /// panel said 70 — the snapshot is read fresh on every render, and the
    /// parent had no reason to render.
    /// </summary>
    [Parameter] public EventCallback OnCatalogueChanged { get; set; }

    private string _filter = string.Empty;

    // ── Your own skills ───────────────────────────────────────────────────

    private IReadOnlyList<string> _folders = [];
    private string _newFolder = string.Empty;
    private string? _folderMessage;

    protected override void OnInitialized() => _folders = Folders.All();

    private void AddFolder()
    {
        _folderMessage = Folders.Add(_newFolder);

        if (_folderMessage is null)
        {
            _newFolder = string.Empty;
            _folders = Folders.All();

            // The catalogue caches, so a folder added without this appears
            // only after a restart — which looks exactly like it not working.
            Reload();
            _ = OnCatalogueChanged.InvokeAsync();
        }
    }

    private void RemoveFolder(string folder)
    {
        _folderMessage = Folders.Remove(folder);
        _folders = Folders.All();
        Reload();
        _ = OnCatalogueChanged.InvokeAsync();
    }

    /// <summary>The last segment of a path, whichever slash it ends with.</summary>
    private static string FolderName(string path)
        => System.IO.Path.GetFileName(path.TrimEnd(System.IO.Path.DirectorySeparatorChar,
                                                   System.IO.Path.AltDirectorySeparatorChar));

    private void Reload()
    {
        if (SkillCatalog is SkillCatalogService catalogue)
        {
            catalogue.Refresh();
        }
    }

    // Narrow while typing. Waiting for blur on a list of sixty-nine is waiting
    // for the wrong event.
    private void OnFilterChanged(ChangeEventArgs e)
        => _filter = e.Value?.ToString() ?? string.Empty;

    private Task Close() => OnClose.InvokeAsync();
}
