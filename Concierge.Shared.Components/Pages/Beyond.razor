@page "/beyond"
@inject IBeyondClaudeService BeyondClaude
@inject IMeshTransportService Mesh

@{
    var snapshot = BeyondClaude.GetSnapshot();
    var mesh = Mesh.GetSnapshot();
}

<section class="page-header">
    <p class="eyebrow">Beyond Code</p>
    <h1>Concierge should help people run the work, not only write the code.</h1>
    <p class="lede">This is the first product slice from the reference-repo audit: memory, helpers, simulations, infrastructure, diagrams, safe resume, lightweight mode, security, media, and cross-platform release readiness.</p>
</section>

<section class="metric-grid">
    <div class="metric"><strong>@snapshot.Capabilities.Count</strong><span>new capability lanes</span></div>
    <div class="metric"><strong>@snapshot.WorkforceSwarms.Sum(swarm => swarm.Agents.Count)</strong><span>scoped helpers</span></div>
    <div class="metric"><strong>@snapshot.MemoryRooms.Count</strong><span>memory rooms</span></div>
    <div class="metric"><strong>@(snapshot.SafeResume.RequiresUserApproval ? "On" : "Off")</strong><span>safe resume approval</span></div>
</section>

<section class="card-grid">
    @foreach (var capability in snapshot.Capabilities)
    {
        <article class="surface-card ready">
            <strong>@capability.PlainEnglishName</strong>
            <span>@capability.Name - inspired by @capability.InspiredBy</span>
            <p>@capability.Summary</p>
            <p><b>Why it matters:</b> @capability.WhyItMatters</p>
            <p><b>Safety:</b> @capability.SafetyBoundary</p>
        </article>
    }
</section>

<section class="section-stack">
    <article class="surface-card accent">
        <strong>Memory rooms</strong>
        <span>Local first, portable, and understandable to a human.</span>
        @foreach (var room in snapshot.MemoryRooms)
        {
            <p><b>@room.Name:</b> @room.Purpose</p>
        }
    </article>

    <article class="surface-card accent">
        <strong>Workforce mode</strong>
        <span>Small teams with names, limits, and visible responsibilities.</span>
        @foreach (var swarm in snapshot.WorkforceSwarms)
        {
            <p><b>@swarm.Name:</b> @swarm.Purpose</p>
        }
    </article>

    <article class="surface-card accent">
        <strong>Safe auto-resume</strong>
        <span>@snapshot.SafeResume.Summary</span>
        <p>Requires approval: @YesNo(snapshot.SafeResume.RequiresUserApproval). Keeps sandbox: @YesNo(snapshot.SafeResume.KeepsOriginalSandbox). Blocks bypass: @YesNo(snapshot.SafeResume.BlocksPermissionBypass).</p>
    </article>

    <article class="surface-card @(mesh.IsActive ? "ready" : "")">
        <strong>Mesh transport - @mesh.Engine v@(mesh.EngineVersion)</strong>
        <span>Node tag: @mesh.NodeTag</span>
        <p>@mesh.Summary</p>
        <p>Cached routes: @mesh.CachedRoutes. Known peers: @mesh.KnownPeers. Pending bundles: @mesh.PendingBundles. Active: @YesNo(mesh.IsActive). Identity persisted: @YesNo(mesh.IdentityIsPersisted).</p>
    </article>
</section>

@code {
    private static string YesNo(bool value)
    {
        return value ? "yes" : "no";
    }
}
