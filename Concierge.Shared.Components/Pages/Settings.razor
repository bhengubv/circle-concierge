@page "/settings"
@inject IConciergeStateService Concierge
@inject ILlmRuntimeService LlmRuntime
@inject IEnumerable<IChatRuntime> ChatRuntimes
@inject IJSRuntime JS

@{
    var snapshot = Concierge.GetSnapshot();
    var runtime = LlmRuntime.GetSnapshot();
    var chatRuntimes = ChatRuntimes
        .GroupBy(r => r.Id, StringComparer.OrdinalIgnoreCase)
        .Select(g => g.First())
        .OrderByDescending(r => string.Equals(r.Id, "circleai", StringComparison.OrdinalIgnoreCase))
        .ThenBy(r => r.EngineLabel, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<section class="page-header">
    <p class="eyebrow">Settings</p>
    <h1>Make Concierge safe for your machine and your way of working.</h1>
    <p class="lede">Simple controls for models, skills, resources, secrets, approvals, MCP, notifications, and portability.</p>
</section>

@*
    Default chat provider — the philosophical anchor of the product.
    CircleAI is the local-first default; cloud providers are escape hatches
    for when the user has an API key and wants a hosted model. The
    dropdown writes localStorage["concierge-provider-id"] which Chat.razor
    reads at OnInitializedAsync to pick the active runtime.
*@
<section class="panel">
    <div class="section-heading">
        <p class="eyebrow">Default AI</p>
        <h2>Who answers when you ask</h2>
    </div>
    <p class="lede">
        Concierge runs on <strong>CircleAI</strong> by default — your phone
        does the thinking, nothing leaves the device. If you have an API key
        for a cloud model, you can switch here. Either way, the conversation
        always uses the engine picked below.
    </p>
    <div class="card-list">
        @foreach (var rt in chatRuntimes)
        {
            var isSelected = (_selectedProviderId is null && string.Equals(rt.Id, "circleai", StringComparison.OrdinalIgnoreCase))
                          || string.Equals(rt.Id, _selectedProviderId, StringComparison.OrdinalIgnoreCase);
            var statusBadge = rt.IsReady ? "ready" : "loading";
            <article class="surface-card @(isSelected ? "ready" : "")"
                     @onclick="@(() => SelectProviderAsync(rt.Id))"
                     style="cursor:pointer">
                <strong>@rt.EngineLabel</strong>
                <span>@rt.StatusMessage</span>
                <p>
                    @if (isSelected) { <text>✓ Selected — </text> }
                    @if (string.Equals(rt.Id, "circleai", StringComparison.OrdinalIgnoreCase))
                    {
                        <text>Local model, runs on this device. No API key, no network.</text>
                    }
                    else
                    {
                        <text>@statusBadge · cloud API. Add your key below to enable.</text>
                    }
                </p>
            </article>
        }
    </div>
</section>

<section class="two-column">
    <div class="panel">
        <div class="section-heading"><p class="eyebrow">Resources</p><h2>Local limits</h2></div>
        <div class="setting-row"><span>Concurrent runs</span><strong>@snapshot.ResourceControl.MaxConcurrentRuns</strong></div>
        <div class="setting-row"><span>Background runs</span><strong>@snapshot.ResourceControl.MaxBackgroundRuns</strong></div>
        <div class="setting-row"><span>Timeout</span><strong>@snapshot.ResourceControl.RunTimeoutMinutes min</strong></div>
        <div class="setting-row"><span>Cleanup owned processes</span><strong>@(snapshot.ResourceControl.CleanupOwnedProcesses ? "On" : "Off")</strong></div>
    </div>
    <div class="panel">
        <div class="section-heading"><p class="eyebrow">Providers</p><h2>Official APIs</h2></div>
        <div class="card-list">
            @foreach (var provider in snapshot.Providers)
            {
                <article class="surface-card">
                    <strong>@provider.Name</strong>
                    <span>@provider.OfficialApi</span>
                </article>
            }
        </div>
    </div>
</section>

<section class="panel">
    <div class="section-heading"><p class="eyebrow">On-device runtime</p><h2>@runtime.Engine v@(runtime.EngineVersion)</h2></div>
    <div class="setting-row"><span>Device summary</span><strong>@runtime.DeviceSummary</strong></div>
    <div class="setting-row"><span>Model registry</span><strong>@(runtime.RegistryAvailable ? "available" : "unavailable")</strong></div>
    <div class="card-grid compact">
        @foreach (var model in runtime.ProbedModels)
        {
            <article class="surface-card @(model.Available ? "ready" : "")">
                <strong>@model.Name</strong>
                <span>@model.Version - @model.Quantization</span>
                <p>@(model.Available ? "Available in the CircleAI registry." : "Not present in the embedded registry.")</p>
            </article>
        }
    </div>
    <p class="lede">@runtime.Summary</p>
</section>

<ApiKeyEditor />

@code {
    private const string ProviderPreferenceStorageKey = "concierge-provider-id";
    private string? _selectedProviderId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _selectedProviderId = await JS.InvokeAsync<string?>("localStorage.getItem", ProviderPreferenceStorageKey);
            StateHasChanged();
        }
        catch { /* localStorage unavailable during prerender or on platforms that block it. */ }
    }

    private async Task SelectProviderAsync(string providerId)
    {
        _selectedProviderId = providerId;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ProviderPreferenceStorageKey, providerId);
        }
        catch { /* best-effort */ }
        StateHasChanged();
    }
}

