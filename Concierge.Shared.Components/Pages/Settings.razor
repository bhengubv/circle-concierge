@using CircleAI.ContentPolicy
@using Concierge.Shared.Safety
@inject IConciergeStateService Concierge
@inject ILlmRuntimeService LlmRuntime
@inject ConciergeSafetySettings SafetySettings
@inject ISafetyAuditLog SafetyAudit
@inject IJSRuntime JS

@*
    Settings, as a panel over the work.

    It is no longer a route. Neither reference has a settings screen you travel
    to: Claude Design floats a dark Tweaks panel over the canvas, and Codex keeps
    the two settings that matter — approval and model — in the composer itself.
    Concierge already moved those two. What is left here is everything you change
    rarely, and changing it should not mean leaving the conversation.

    The controls follow the reference rather than the web's defaults: either/or
    choices are segmented pickers, not dropdowns, so the options are visible and
    choosing is one press instead of two.
*@

@{
    var snapshot = Concierge.GetSnapshot();
    var runtime = LlmRuntime.GetSnapshot();
}

<div class="sheet-back" @onclick="Close" aria-hidden="true"></div>

<div class="sheet" role="dialog" aria-modal="true" aria-labelledby="settings-title">
    <div class="sheet-head">
        <h1 class="sheet-title" id="settings-title">Settings</h1>
        <button class="icon-btn" type="button" title="Close" @onclick="Close">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span class="sr">Close settings</span>
        </button>
    </div>

    <section class="appearance-panel" aria-label="Appearance">
        <div class="appearance-heading">Make it yours</div>
        <div class="appearance-caption">Theme</div>
        <div class="seg appearance-themes" role="group" aria-label="Theme">
            @foreach (var theme in new[] { ("auto", "Device"), ("light", "Light"), ("dark", "Dark") })
            {
                <button class="seg-opt @(_appearanceTheme == theme.Item1 ? "is-on" : null)" type="button"
                        aria-pressed="@(_appearanceTheme == theme.Item1 ? "true" : "false")"
                        @onclick="@(() => SetAppearanceThemeAsync(theme.Item1))">@theme.Item2</button>
            }
        </div>
        <div class="appearance-caption">Colour</div>
        <div class="appearance-skins" role="group" aria-label="Colour skin">
            @foreach (var skin in new[] { ("circle", "Circle"), ("tide", "Tide"), ("berry", "Berry") })
            {
                <button class="appearance-skin skin-@skin.Item1 @(_appearanceSkin == skin.Item1 ? "is-on" : null)" type="button"
                        aria-pressed="@(_appearanceSkin == skin.Item1 ? "true" : "false")"
                        @onclick="@(() => SetAppearanceSkinAsync(skin.Item1))">
                    <span class="skin-swatch" aria-hidden="true"></span><span>@skin.Item2</span>
                </button>
            }
        </div>
        <p class="appearance-caption auto-model-note">Circle AI chooses the best available model for this device. It asks before downloads or paid actions.</p>
    </section>

    @* ── Automatic model choice ─────────────────────────────────────── *@
    <section class="sheet-group">
        <div class="row">
            <span class="row-name">
                Circle AI chooses the model
                <span class="row-sub">It picks from the options available on this device. Add provider keys below; Circle AI handles the routing.</span>
            </span>
        </div>
    </section>

    @* ── Keys ────────────────────────────────────────────────────────── *@
    @*
        Provider credentials are optional capabilities; Circle AI decides when
        an available model is the right choice for the current device and task.
    *@
    <section class="sheet-group">
        <button class="sheet-head-btn" type="button" @onclick="@(() => Toggle("keys"))">
            <svg class="ws-chev @(IsOpen("keys") ? "is-open" : null)" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
            <span class="sheet-label">Keys</span>
        </button>
        @if (IsOpen("keys"))
        {
            <ApiKeyEditor />
        }
    </section>

    @* ── Family mode ─────────────────────────────────────────────────── *@
    <section class="sheet-group">
        <button class="sheet-head-btn" type="button" @onclick="@(() => Toggle("family"))">
            <svg class="ws-chev @(IsOpen("family") ? "is-open" : null)" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
            <span class="sheet-label">Family mode</span>
        </button>
        @if (IsOpen("family"))
        {

        <div class="row">
            <span class="row-name">
                Kid mode
                <span class="row-sub">Filters every prompt and every reply on this device.</span>
            </span>
            <label class="toggle">
                <input type="checkbox" checked="@SafetySettings.KidMode" @onchange="OnKidModeChanged" />
                <span class="toggle-track" aria-hidden="true"><span class="toggle-knob"></span></span>
                <span class="sr">Kid mode</span>
            </label>
        </div>

        @*
            A segmented picker, not a <select>. Three options that are visible
            and one press to change — the pattern both references use for a
            choice this small.
        *@
        <div class="row">
            <span class="row-name">Strictness</span>
            <div class="seg" role="group" aria-label="Strictness">
                @foreach (var level in new[] { SafetyStrictness.Off, SafetyStrictness.Balanced, SafetyStrictness.Strict })
                {
                    var choice = level;
                    <button class="seg-opt @(SafetySettings.Strictness == choice ? "is-on" : null)"
                            type="button"
                            aria-pressed="@(SafetySettings.Strictness == choice ? "true" : "false")"
                            @onclick="@(() => SetStrictness(choice))">@choice</button>
                }
            </div>
        </div>

        @if (SafetySettings.KidMode || SafetySettings.Strictness != SafetyStrictness.Off)
        {
            <div class="row">
                <span class="row-name">Profile label</span>
                <input class="comp-input" style="max-width:200px;" type="text" placeholder="Optional"
                       value="@SafetySettings.ProfileLabel" @onchange="OnProfileLabelChanged" />
            </div>
        }
        }
    </section>

    @* ── Limits ──────────────────────────────────────────────────────── *@
    <section class="sheet-group">
        <button class="sheet-head-btn" type="button" @onclick="@(() => Toggle("limits"))">
            <svg class="ws-chev @(IsOpen("limits") ? "is-open" : null)" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
            <span class="sheet-label">Limits</span>
        </button>
        @if (IsOpen("limits"))
        {
        <div class="rows">
            <div class="row"><span class="row-name">Jobs at once</span><span class="row-val">@snapshot.ResourceControl.MaxConcurrentRuns</span></div>
            <div class="row"><span class="row-name">Background jobs</span><span class="row-val">@snapshot.ResourceControl.MaxBackgroundRuns</span></div>
            <div class="row"><span class="row-name">Give up after</span><span class="row-val">@snapshot.ResourceControl.RunTimeoutMinutes min</span></div>
            <div class="row"><span class="row-name">Clean up owned processes</span><span class="row-val">@(snapshot.ResourceControl.CleanupOwnedProcesses ? "On" : "Off")</span></div>
        </div>
        }
    </section>

    @* ── Reference ───────────────────────────────────────────────────── *@
    <section class="sheet-group">
        <button class="sheet-head-btn" type="button" @onclick="@(() => Toggle("device"))">
            <svg class="ws-chev @(IsOpen("device") ? "is-open" : null)" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
            <span class="sheet-label">On this device</span>
        </button>
        @if (IsOpen("device"))
        {
        <div class="rows">
            <div class="row"><span class="row-name">Engine</span><span class="row-val">@runtime.Engine v@(runtime.EngineVersion)</span></div>
            <div class="row"><span class="row-name">Device</span><span class="row-val">@runtime.DeviceSummary</span></div>
            <div class="row">
                <span class="row-name">Model registry</span>
                <span class="state">
                    <span class="dot @(runtime.RegistryAvailable ? "dot-done" : "dot-waiting")" aria-hidden="true"></span>
                    @(runtime.RegistryAvailable ? "Available" : "Unavailable")
                </span>
            </div>
        </div>
        }
    </section>

    @* Shown when there is something to show, or when the log could not be read —
       which used to be swallowed and look exactly like nothing having been caught. *@
    @if (_auditEntries.Count > 0 || _auditUnreadable is not null)
    {
        <section class="sheet-group">
            <button class="sheet-head-btn" type="button" @onclick="@(() => Toggle("audit"))">
                <svg class="ws-chev @(IsOpen("audit") ? "is-open" : null)" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg>
                <span class="sheet-label">What the filter caught</span>
            </button>
            @if (IsOpen("audit"))
            {
            @if (_auditUnreadable is not null)
            {
                <p class="row-sub">
                    The record could not be read, so this is not "nothing was caught" —
                    it is "nobody can tell". @_auditUnreadable
                </p>
            }
            <div class="rows">
                @foreach (var entry in _auditEntries.Take(10))
                {
                    <div class="row">
                        <span class="row-name">
                            @entry.Action
                            <span class="row-sub">@entry.Reason</span>
                        </span>
                        <span class="row-val">@entry.AtUtc.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                }
            </div>
            }
        </section>
    }
</div>

@code {
    /// <summary>Raised when the panel should close — the backdrop, the close
    /// control, or anything else that dismisses it.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    /// <summary>
    /// Strictness moved from a select to a segmented picker, so the change comes
    /// from a press rather than a ChangeEventArgs. The existing handler is kept
    /// for anything still binding to it.
    /// </summary>
    private async Task SetStrictness(SafetyStrictness level)
    {
        SafetySettings.Strictness = level;
        await RefreshAuditAsync();
    }

    /// <summary>
    /// Which groups are unfolded. The panel is taller than the window it floats
    /// in — five groups of rows — and scrollbars are hidden everywhere in this
    /// app, so a cut-off panel gives no sign there is more. Folding is the same
    /// answer the sidebar uses, and it means the panel fits.
    ///
    /// Keys starts open because it is the only section that needs configuration.
    /// </summary>
    /// One at a time, deliberately. With several groups unfolded the panel ran
    /// 246px past the bottom of the window and, with scrollbars hidden app-wide,
    /// said nothing about it. An accordion cannot outgrow the space it has.
    private string? _open = "keys";

    private bool IsOpen(string key) => string.Equals(_open, key, StringComparison.Ordinal);

    private void Toggle(string key) => _open = IsOpen(key) ? null : key;

}
