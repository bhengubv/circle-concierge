@page "/images"
@using Concierge.Shared.Media
@inject IEnumerable<IImageRuntime> Runtimes

<section class="page-header">
    <p class="eyebrow">Images</p>
    <h1>Generate images with whichever provider you've wired.</h1>
    <p class="lede">Concierge ships adapters for OpenAI DALL-E and Stability AI out of the box. Local SDXL via ONNX/DirectML is on the roadmap; until then this page lets you point at whichever cloud key you've configured and see what comes back.</p>
</section>

<section class="image-runtimes" aria-label="Registered image runtimes">
    @foreach (var runtime in _orderedRuntimes)
    {
        <article class="surface-card @(runtime.IsReady ? "ready" : "needs-attention")">
            <strong>@runtime.EngineLabel</strong>
            <span class="image-runtime-status" data-ready="@runtime.IsReady">
                @(runtime.IsReady ? "Ready" : "Needs key")
            </span>
            <small>@runtime.StatusMessage</small>
        </article>
    }
</section>

<section class="image-composer panel">
    <div class="section-heading">
        <p class="eyebrow">Compose</p>
        <h2>Describe what you want.</h2>
    </div>

    <form class="image-composer-form" @onsubmit="GenerateAsync" @onsubmit:preventDefault>
        <div class="image-composer-row">
            <label for="image-runtime">Runtime</label>
            <select id="image-runtime"
                    value="@_selectedRuntimeId"
                    @onchange="OnRuntimeChanged">
                @foreach (var runtime in _orderedRuntimes)
                {
                    <option value="@runtime.Id">
                        @runtime.EngineLabel @(runtime.IsReady ? "" : "— needs key")
                    </option>
                }
            </select>
        </div>

        <textarea class="image-composer-prompt"
                  rows="4"
                  placeholder="A brand-blue dashboard hero with a softly lit data graph, minimal vector style."
                  @bind="_prompt"
                  @bind:event="oninput"></textarea>

        <textarea class="image-composer-negative"
                  rows="2"
                  placeholder="Negative prompt (Stability only — OpenAI ignores). Optional."
                  @bind="_negative"
                  @bind:event="oninput"></textarea>

        <div class="image-composer-row">
            <label for="image-size">Size</label>
            <select id="image-size" @bind="_size">
                <option value="512">512 × 512</option>
                <option value="1024">1024 × 1024</option>
                <option value="1536">1536 × 1536</option>
            </select>

            <label for="image-count">Count</label>
            <select id="image-count" @bind="_count">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="4">4</option>
            </select>

            <button type="submit"
                    class="button primary"
                    disabled="@(!CanGenerate)">
                @(_busy ? "Generating…" : "Generate")
            </button>
        </div>

        <p class="image-status">@_statusMessage</p>
    </form>
</section>

@if (_artifacts.Count > 0)
{
    <section class="image-results">
        @foreach (var artifact in _artifacts)
        {
            <article class="image-card">
                @if (!string.IsNullOrEmpty(artifact.Url))
                {
                    <img src="@artifact.Url" alt="@artifact.Prompt" loading="lazy" />
                }
                else if (artifact.Bytes is { Length: > 0 })
                {
                    <img src="@($"data:{artifact.MimeType};base64,{Convert.ToBase64String(artifact.Bytes)}")"
                         alt="@artifact.Prompt"
                         loading="lazy" />
                }
                else
                {
                    <div class="image-card-empty">No payload returned.</div>
                }
                <footer>
                    <span>@artifact.RuntimeId · @artifact.GeneratedAtUtc.ToLocalTime():t</span>
                </footer>
            </article>
        }
    </section>
}

@code {
    private List<IImageRuntime> _orderedRuntimes = new();
    private string? _selectedRuntimeId;
    private string _prompt = string.Empty;
    private string _negative = string.Empty;
    private int _size = 1024;
    private int _count = 1;
    private bool _busy;
    private string _statusMessage = "Pick a runtime + describe an image.";
    private List<ImageArtifact> _artifacts = new();

    protected override void OnInitialized()
    {
        _orderedRuntimes = Runtimes
            .GroupBy(r => r.Id, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderByDescending(r => r.IsReady)
            .ThenBy(r => r.EngineLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _selectedRuntimeId = _orderedRuntimes.FirstOrDefault(r => r.IsReady)?.Id ?? _orderedRuntimes.FirstOrDefault()?.Id;
    }

    private bool CanGenerate => !_busy
        && !string.IsNullOrWhiteSpace(_prompt)
        && _selectedRuntimeId is not null
        && _orderedRuntimes.FirstOrDefault(r => r.Id == _selectedRuntimeId)?.IsReady == true;

    private void OnRuntimeChanged(ChangeEventArgs args)
    {
        _selectedRuntimeId = args.Value?.ToString();
    }

    private async Task GenerateAsync()
    {
        if (!CanGenerate)
        {
            return;
        }

        var runtime = _orderedRuntimes.First(r => r.Id == _selectedRuntimeId);
        _busy = true;
        _statusMessage = $"Calling {runtime.EngineLabel}…";
        try
        {
            var request = new ImageGenerationRequest(
                Prompt: _prompt.Trim(),
                NegativePrompt: string.IsNullOrWhiteSpace(_negative) ? null : _negative.Trim(),
                Size: _size,
                Count: _count);
            var produced = await runtime.GenerateAsync(request);
            // Newest-first so the page doesn't bury fresh results.
            _artifacts = produced.Concat(_artifacts).ToList();
            _statusMessage = produced.Count > 0
                ? $"Got {produced.Count} image(s)."
                : "Runtime returned nothing. Check the engine status pill above.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Generation failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
