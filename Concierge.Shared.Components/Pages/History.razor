@page "/history"
@using Concierge.Shared.Chat
@inject IConversationStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS

@*
    History — every past chat with Bell, newest first. Tap to open. Long-press
    (or the trailing trash button) deletes. Empty state walks the user back
    to Home so there's never a dead end.
*@

<div class="page">
    <header class="page-head">
        <h1 class="page-title">History</h1>
        <p class="page-sub">Every chat you've had with Bell. Tap one to keep going.</p>
    </header>

    @if (_loading)
    {
        <div class="page-stub">
            <p>Looking up your conversations…</p>
        </div>
    }
    else if (_conversations is null || _conversations.Count == 0)
    {
        <section class="empty-card">
            <h2>No chats yet</h2>
            <p>You haven't talked to Bell yet. When you do, every conversation lands here so you can come back to it whenever.</p>
            <a class="page-cta" href="/">Say hello to Bell</a>
        </section>
    }
    else
    {
        <ul class="history-list">
            @foreach (var c in _conversations)
            {
                var conv = c;
                var lastMsg = conv.Messages.LastOrDefault();
                var preview = lastMsg is null
                    ? "(no messages yet)"
                    : (lastMsg.Content.Length > 120
                        ? lastMsg.Content.Substring(0, 117) + "…"
                        : lastMsg.Content);
                <li class="history-item">
                    <a class="history-body" href="@($"/chat/{conv.Id}")">
                        <strong>@conv.Title</strong>
                        <span class="history-preview">@preview</span>
                        <span class="history-meta">@RelativeTime(conv.UpdatedAt) · @conv.Messages.Count messages</span>
                    </a>
                    <button class="history-delete"
                            type="button"
                            aria-label="@($"Delete {conv.Title}")"
                            @onclick="@(() => RequestDelete(conv.Id))">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                        </svg>
                    </button>
                </li>
            }
        </ul>
    }

    @if (_pendingDeleteId is not null)
    {
        <div class="confirm-backdrop" @onclick="CancelDelete" aria-hidden="true"></div>
        <div class="confirm-panel" role="alertdialog" aria-labelledby="confirmTitle">
            <h2 id="confirmTitle">Delete this chat?</h2>
            <p>This will remove the conversation from your history. There's no undo.</p>
            <div class="confirm-actions">
                <button type="button" class="page-button quiet" @onclick="CancelDelete">Keep it</button>
                <button type="button" class="page-button danger" @onclick="ConfirmDelete">Delete</button>
            </div>
        </div>
    }
</div>

@code {
    private const string OwnerId = "local";
    private bool _loading = true;
    private List<Conversation>? _conversations;
    private Guid? _pendingDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var list = await Store.ListAsync(OwnerId);
            _conversations = list.OrderByDescending(c => c.UpdatedAt).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void RequestDelete(Guid id) => _pendingDeleteId = id;
    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDelete()
    {
        var id = _pendingDeleteId;
        _pendingDeleteId = null;
        if (id is null) return;
        try { await JS.InvokeVoidAsync("conciergeSense.hapticAttention"); } catch { }
        await Store.DeleteAsync(id.Value);
        await ReloadAsync();
    }

    private static string RelativeTime(DateTimeOffset when)
    {
        var span = DateTimeOffset.UtcNow - when;
        if (span.TotalSeconds < 60) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24)   return $"{(int)span.TotalHours} h ago";
        if (span.TotalDays < 7)     return $"{(int)span.TotalDays} d ago";
        return when.ToLocalTime().ToString("MMM d, HH:mm");
    }
}
