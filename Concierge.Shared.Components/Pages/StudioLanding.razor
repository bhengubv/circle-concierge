@page "/studio"
@using Concierge.Shared.Planning
@inject IProjectStore Projects
@inject IServiceProvider Services
@implements IDisposable

<main class="cm-studio" aria-labelledby="cm-studio-title">
    <p class="cm-home-eyebrow">CONCIERGE STUDIO</p>
    <h1 id="cm-studio-title">Make it real.</h1>
    <p class="cm-studio-intro">Your projects, the work inside them, and the tools to make more.</p>
    <nav class="cm-studio-actions" aria-label="Studio actions">
        <a href="/projects">New project <span aria-hidden="true">↗</span></a>
        <a href="/creator">Create on canvas <span aria-hidden="true">↗</span></a>
    </nav>
    <section aria-labelledby="cm-studio-3d">
        <h2 id="cm-studio-3d">Make a 3D draft</h2>
        <p>@(Infinigen?.Status ?? "3D generation is available from Concierge Desktop.")</p>
        @if (Infinigen?.IsAvailable == true)
        {
            <button type="button" disabled="@_making3d" @onclick="Make3dAsync">@(_making3d ? "Making a sofa…" : "Make a sofa")</button>
            @if (_making3d) { <button type="button" @onclick="Stop3d">Stop</button> }
        }
        @if (_draft3d is not null) { <p role="status">Draft saved in Concierge Studio: @_draft3d</p> }
        @if (_draft3dError is not null) { <p role="alert">@_draft3dError</p> }
    </section>
    <section aria-labelledby="cm-studio-projects">
        <h2 id="cm-studio-projects">Projects</h2>
        @if (_error is not null) { <p role="alert">@_error</p> }
        else if (_loading) { <p role="status">Loading projects…</p> }
        else if (_projects.Count == 0)
        {
            <div class="cm-studio-empty"><strong>Start with an idea.</strong><span>A project keeps the steps, decisions and results together.</span><a href="/projects">Explore project examples</a></div>
        }
        else
        {
            @foreach (var group in _projects.GroupBy(project => project.WorkType).OrderBy(group => GroupOrder(group.Key)))
            {
                <details class="cm-studio-group">
                    <summary><span>@GroupName(group.Key)</span><small>@group.Count() project@(group.Count() == 1 ? "" : "s")</small></summary>
                    <div class="cm-studio-project-list">
                        @foreach (var project in group.OrderByDescending(project => project.UpdatedAt))
                        {
                            <a href="@($"/projects?project={project.Id}")"><strong>@project.Name</strong><span>@project.Status · @project.Workflows.Count workflow@(project.Workflows.Count == 1 ? "" : "s")</span></a>
                        }
                    </div>
                </details>
            }
        }
    </section>
</main>

@code {
    private IReadOnlyList<ConciergeProject> _projects = [];
    private bool _loading = true;
    private string? _error;
    private Concierge.Shared.Design.InfinigenDrafts? Infinigen => Services.GetService(typeof(Concierge.Shared.Design.InfinigenDrafts)) as Concierge.Shared.Design.InfinigenDrafts;
    private bool _making3d;
    private CancellationTokenSource? _draft3dCancellation;
    private string? _draft3d;
    private string? _draft3dError;
    private async Task Make3dAsync()
    {
        _making3d = true;
        _draft3dError = null;
        _draft3dCancellation = new CancellationTokenSource();
        try { _draft3d = await Infinigen!.CreateSofaAsync(0, _draft3dCancellation.Token); }
        catch (OperationCanceledException) { _draft3dError = "3D draft stopped."; }
        catch (Exception ex) { _draft3dError = $"3D draft failed: {ex.Message}"; }
        finally { _making3d = false; _draft3dCancellation.Dispose(); _draft3dCancellation = null; }
    }
    private void Stop3d() => _draft3dCancellation?.Cancel();
    public void Dispose() => _draft3dCancellation?.Cancel();
    protected override async Task OnInitializedAsync()
    {
        try { _projects = await Projects.ListAsync(); }
        catch (Exception ex) { _error = $"Projects could not load: {ex.Message}"; }
        finally { _loading = false; }
    }
    private static string GroupName(string workType) => workType switch
    {
        "Business" => "Work",
        "Personal & creative" => "Home & personal",
        "General" => "Other projects",
        _ => workType
    };
    private static int GroupOrder(string workType) => workType switch
    {
        "Business" => 0,
        "Personal & creative" => 1,
        _ => 2
    };
}
