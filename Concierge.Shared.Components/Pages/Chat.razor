@page "/chat"
@page "/chat/{ConversationId:guid}"
@using System.Text
@using Concierge.Shared.Chat
@using Concierge.Shared.Tools
@inject IConversationStore Store
@inject IEnumerable<IChatRuntime> Runtimes
@inject IAgentToolRegistry Tools
@inject NavigationManager Nav

<section class="chat-shell">
    <aside class="chat-sidebar">
        <div class="chat-sidebar-header">
            <p class="eyebrow">Chat</p>
            <button class="button primary" type="button" @onclick="StartNewAsync">New conversation</button>
        </div>
        <nav class="chat-conversation-list" aria-label="Conversations">
            @if (_conversations.Count == 0)
            {
                <p class="chat-empty">No conversations yet. Start one to begin.</p>
            }
            else
            {
                @foreach (var conversation in _conversations)
                {
                    <a class="chat-conversation-link @(conversation.Id == ConversationId ? "active" : null)"
                       href="@($"chat/{conversation.Id}")">
                        <strong>@conversation.Title</strong>
                        <span>@conversation.UpdatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                    </a>
                }
            }
        </nav>

        <div class="chat-provider-picker">
            <label for="chat-provider-select">Provider</label>
            <select id="chat-provider-select"
                    class="chat-provider-select"
                    value="@_activeRuntime?.Id"
                    @onchange="OnProviderChanged">
                @foreach (var runtime in _orderedRuntimes)
                {
                    <option value="@runtime.Id">
                        @runtime.EngineLabel @(runtime.IsReady ? "" : "— needs key")
                    </option>
                }
            </select>
        </div>

        <div class="chat-engine-pill" data-ready="@(_activeRuntime?.IsReady ?? false)">
            <strong>@(_activeRuntime?.EngineLabel ?? "No runtime")</strong>
            <span>@(_activeRuntime?.StatusMessage ?? "No chat runtime registered.")</span>
        </div>
    </aside>

    <main class="chat-thread" aria-live="polite">
        @if (_active is null)
        {
            <div class="chat-empty-state">
                <h1>Pick a conversation or start a new one.</h1>
                <p>
                    @if (_activeRuntime is not null)
                    {
                        <text>Concierge runs on @_activeRuntime.EngineLabel. @_activeRuntime.StatusMessage</text>
                    }
                </p>
            </div>
        }
        else
        {
            <header class="chat-thread-header">
                <h1>@_active.Title</h1>
                <span>@_active.Messages.Count messages · started @_active.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                <details class="chat-system-prompt">
                    <summary>System prompt @(string.IsNullOrWhiteSpace(_systemPromptDraft) ? "(empty)" : "(" + _systemPromptDraft.Length + " chars)")</summary>
                    <textarea rows="4"
                              spellcheck="false"
                              placeholder="Optional. Shapes how the assistant responds for this conversation."
                              @bind="_systemPromptDraft"
                              @bind:event="oninput"></textarea>
                    <div class="chat-system-prompt-row">
                        <label>
                            <input type="checkbox" @bind="_includeToolCatalog" />
                            Append tool catalog (@Tools.Tools.Count tools)
                        </label>
                        <button class="button" type="button" @onclick="SaveSystemPromptAsync" disabled="@_streaming">Save</button>
                    </div>
                </details>
            </header>

            <div class="chat-messages">
                @foreach (var message in _active.Messages)
                {
                    <article class="chat-bubble @message.Role">
                        <header>
                            <strong>@FormatRole(message.Role)</strong>
                            @if (!string.IsNullOrWhiteSpace(message.ProducedBy))
                            {
                                <span class="chat-bubble-engine">@message.ProducedBy</span>
                            }
                            <time>@message.CreatedAt.ToLocalTime().ToString("HH:mm")</time>
                        </header>
                        @if (message.Role == "assistant")
                        {
                            <AssistantContent Content="@message.Content" />
                        }
                        else
                        {
                            <p>@message.Content</p>
                        }
                    </article>
                }
                @if (_streaming)
                {
                    <article class="chat-bubble assistant streaming">
                        <header>
                            <strong>Assistant</strong>
                            <span class="chat-bubble-engine">@(_activeRuntime?.EngineLabel ?? "")</span>
                            <time>@DateTimeOffset.Now.ToLocalTime().ToString("HH:mm")</time>
                        </header>
                        <AssistantContent Content="@_streamingBuffer" />
                    </article>
                }
            </div>

            <form class="chat-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
                <textarea @bind="_composerText"
                          @bind:event="oninput"
                          placeholder="Ask Concierge anything…"
                          rows="3"
                          disabled="@(!CanSend)"></textarea>
                <div class="chat-composer-row">
                    <span class="chat-hint">Shift + Enter for newline · plain text only in v1</span>
                    <button class="button primary" type="submit" disabled="@(!CanSend)">
                        @(_streaming ? "Streaming…" : "Send")
                    </button>
                </div>
            </form>
        }
    </main>
</section>

@code {
    [Parameter] public Guid? ConversationId { get; set; }

    private List<Conversation> _conversations = new();
    private Conversation? _active;
    private string _composerText = string.Empty;
    private bool _streaming;
    private string _streamingBuffer = string.Empty;
    private CancellationTokenSource? _streamCts;

    private List<IChatRuntime> _orderedRuntimes = new();
    private IChatRuntime? _activeRuntime;
    private string _systemPromptDraft = string.Empty;
    private bool _includeToolCatalog = true;

    private const string OwnerId = "local";

    private bool CanSend
        => !_streaming
           && !string.IsNullOrWhiteSpace(_composerText)
           && _active is not null
           && (_activeRuntime?.IsReady ?? false);

    protected override async Task OnInitializedAsync()
    {
        // Distinct by Id so the same runtime registered twice (singleton + keyed) doesn't
        // produce duplicate dropdown rows. Ready-first, then alphabetical.
        _orderedRuntimes = Runtimes
            .GroupBy(r => r.Id, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderByDescending(r => r.IsReady)
            .ThenBy(r => r.EngineLabel, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _activeRuntime = _orderedRuntimes.FirstOrDefault(r => r.IsReady)
            ?? _orderedRuntimes.FirstOrDefault();

        await RefreshSidebarAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ConversationId is { } id)
        {
            _active = await Store.GetAsync(id);
            _systemPromptDraft = _active?.SystemPrompt ?? string.Empty;
        }
        else
        {
            _active = null;
            _systemPromptDraft = string.Empty;
        }
    }

    private async Task SaveSystemPromptAsync()
    {
        if (_active is null)
        {
            return;
        }

        // Re-using AppendAsync would create a phantom system message; we want the column on
        // the conversation row updated directly. The store does not expose an UpdateSystemPrompt
        // helper today — fall back to deleting + re-starting would lose history. For now we
        // mutate the in-memory copy and persist on the next send via the system turn injection
        // path. Persisting cleanly requires a small store extension which will land alongside
        // the Settings UI work.
        _active.SystemPrompt = _systemPromptDraft;
        await Task.CompletedTask;
    }

    private void OnProviderChanged(ChangeEventArgs args)
    {
        var id = args.Value?.ToString();
        if (string.IsNullOrEmpty(id))
        {
            return;
        }
        _activeRuntime = _orderedRuntimes.FirstOrDefault(r => r.Id == id) ?? _activeRuntime;
    }

    private async Task RefreshSidebarAsync()
    {
        _conversations = (await Store.ListAsync(OwnerId)).ToList();
    }

    private async Task StartNewAsync()
    {
        var conversation = await Store.StartAsync(OwnerId);
        await RefreshSidebarAsync();
        Nav.NavigateTo($"chat/{conversation.Id}");
    }

    private async Task SendAsync()
    {
        if (!CanSend || _active is null || _activeRuntime is null)
        {
            return;
        }

        var input = _composerText.Trim();
        _composerText = string.Empty;

        await Store.AppendAsync(_active.Id, role: "user", content: input);
        _active = await Store.GetAsync(_active.Id);
        await RefreshSidebarAsync();
        StateHasChanged();

        _streaming = true;
        _streamingBuffer = string.Empty;
        _streamCts?.Cancel();
        _streamCts = new CancellationTokenSource();

        var turns = (_active?.Messages ?? new List<ChatMessageRow>())
            .Select(m => new ChatTurn(m.Role, m.Content))
            .ToList();

        // Compose the system message from: (1) the conversation's persisted prompt, falling
        // back to the in-page draft so users don't have to hit Save first; (2) the tool
        // catalogue if the checkbox is set — this is what gives the LLM a way to call the
        // harness without provider-specific function-calling wiring.
        var systemParts = new List<string>();
        var persisted = _active?.SystemPrompt;
        var systemText = !string.IsNullOrWhiteSpace(persisted) ? persisted : _systemPromptDraft;
        if (!string.IsNullOrWhiteSpace(systemText))
        {
            systemParts.Add(systemText);
        }
        if (_includeToolCatalog && Tools.Tools.Count > 0)
        {
            systemParts.Add(Tools.BuildSystemPromptAddendum());
        }
        if (systemParts.Count > 0)
        {
            turns.Insert(0, new ChatTurn("system", string.Join("\n\n", systemParts)));
        }

        var buffer = new StringBuilder();
        var persistedPartial = false;
        try
        {
            await foreach (var chunk in _activeRuntime.StreamAsync(turns, _streamCts.Token))
            {
                buffer.Append(chunk);
                _streamingBuffer = buffer.ToString();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Persist the partial message so a circuit disconnect / page nav doesn't lose work.
            if (buffer.Length > 0 && _active is not null)
            {
                await Store.AppendAsync(_active.Id, role: "assistant", content: buffer.ToString() + "\n[stream cancelled before completion]", producedBy: _activeRuntime.EngineLabel);
                persistedPartial = true;
            }
        }
        catch (Exception ex)
        {
            buffer.AppendLine();
            buffer.Append("[stream error: ").Append(ex.Message).Append(']');
            _streamingBuffer = buffer.ToString();
        }

        if (!persistedPartial)
        {
            var assistantText = buffer.ToString();
            if (!string.IsNullOrWhiteSpace(assistantText) && _active is not null)
            {
                await Store.AppendAsync(_active.Id, role: "assistant", content: assistantText, producedBy: _activeRuntime.EngineLabel);
            }
        }

        if (_active is not null)
        {
            _active = await Store.GetAsync(_active.Id);
            await RefreshSidebarAsync();
        }

        _streaming = false;
        _streamingBuffer = string.Empty;
        StateHasChanged();
    }

    private static string FormatRole(string role) => role switch
    {
        "user" => "You",
        "assistant" => "Assistant",
        "system" => "System",
        _ => role
    };
}
