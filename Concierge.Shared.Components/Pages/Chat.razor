@page "/"
@page "/chat"
@page "/chat/{ConversationId:guid}"
@using Concierge.Shared.Components.Workspace
@inject IJSRuntime JS
@implements IDisposable

@*
    Which workspace to render.

    Concierge is one application with three recipes, not one screen bent by
    breakpoints. A watch is not a small desktop: it needs different markup,
    different density and a different first move, and hiding desktop parts
    until a watch fits leaves an empty screen rather than a designed one.

    So each form factor is its own component set. They share WorkspaceBase —
    the conversation list, the send loop, the tool loop, approvals, skills,
    drafts — so they cannot drift in behaviour, and they share nothing else, so
    building one cannot break another.

    Nothing renders until the form factor is known. Rendering a guess and
    correcting it would remount the workspace, which re-runs OnInitializedAsync
    and reloads the thread.
*@

@if (_factor is null)
{
    <div class="ff-wait" aria-busy="true" aria-live="polite">
        <span class="sr">Loading</span>
    </div>
}
else if (_factor == "wearable")
{
    <Concierge.Shared.Components.Workspace.Wearable.Workspace ConversationId="ConversationId" />
}
else if (_factor == "handheld")
{
    <Concierge.Shared.Components.Workspace.Handheld.Workspace ConversationId="ConversationId" />
}
else
{
    <Concierge.Shared.Components.Workspace.Desktop.Workspace ConversationId="ConversationId" />
}

@code {
    /// <summary>
    /// The thread to open, from the route. It belongs to whichever recipe is
    /// chosen, so it is taken here and handed down.
    /// </summary>
    [Parameter] public Guid? ConversationId { get; set; }

    /// <summary>
    /// Null until the viewport has been measured — see the note above about
    /// why a guess is worse than a blank frame.
    /// </summary>
    private string? _factor;

    private DotNetObjectReference<Chat>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _self = DotNetObjectReference.Create(this);

            // watch() returns the current answer as well as subscribing, so
            // this is one call rather than a measure and then a subscribe.
            _factor = await JS.InvokeAsync<string>("conciergeFormFactor.watch", _self);
        }
        catch (Exception)
        {
            // Interop can fail during prerender, or if the script did not
            // load. Desktop is the safe answer: it is the recipe that assumes
            // the most room, and being wrong there is a cramped screen rather
            // than an unreachable one.
            _factor = "desktop";
        }

        StateHasChanged();
    }

    /// <summary>
    /// A desktop window dragged narrow, or a foldable opened. Only fires when
    /// the answer actually changes.
    /// </summary>
    [JSInvokable]
    public Task OnFormFactorChanged(string factor)
    {
        if (string.Equals(factor, _factor, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _factor = factor;
        return InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Fire and forget: Dispose cannot await, and a failure here means the
        // page is already gone.
        _ = JS.InvokeVoidAsync("conciergeFormFactor.unwatch");
        _self?.Dispose();
    }
}
