@*
    Bell — the Concierge mascot. A brass desk-bell character, drawn as inline
    SVG so it loads in one paint and animates with CSS. Universally
    recognisable across ages: 8-year-old sees a friendly bell, 70-year-old
    sees a hotel-lobby concierge bell from her honeymoon. Same emotional read.

    States:
      • Idle   — gentle bob + slow blink (default)
      • Listening — slight forward tilt + pulsing handle (mic active)
      • Thinking  — handle wobble + radiating arcs (AI is working)
      • Cheering  — bounce + spark particles (after a delightful result)

    Set <Bell State="idle | listening | thinking | cheering" /> from any page.
    No Material/MudBlazor dependency — pure SVG + CSS.
*@

<div class="bell-stage bell-@State" aria-label="Concierge helper" role="img">
    <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="bell-svg">
        <!-- Soft sun glow behind Bell — warmth, not chrome. -->
        <defs>
            <radialGradient id="bellHalo" cx="50%" cy="55%" r="55%">
                <stop offset="0%"  stop-color="#fff4d6" stop-opacity="0.85"/>
                <stop offset="60%" stop-color="#fff4d6" stop-opacity="0.0"/>
            </radialGradient>
            <linearGradient id="bellBody" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%"  stop-color="#ffd76b"/>
                <stop offset="55%" stop-color="#e8a93a"/>
                <stop offset="100%" stop-color="#b97a1a"/>
            </linearGradient>
            <linearGradient id="bellBase" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%"  stop-color="#3a3a44"/>
                <stop offset="100%" stop-color="#1d1d24"/>
            </linearGradient>
            <radialGradient id="bellSheen" cx="38%" cy="35%" r="35%">
                <stop offset="0%"  stop-color="#fff8dc" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#fff8dc" stop-opacity="0"/>
            </radialGradient>
        </defs>

        <!-- Halo -->
        <circle cx="100" cy="110" r="92" fill="url(#bellHalo)" class="bell-halo"/>

        <!-- Listening / thinking radar arcs (CSS-toggled visibility) -->
        <g class="bell-radar" stroke="#2196F3" stroke-width="2" fill="none" opacity="0">
            <circle cx="100" cy="115" r="60"/>
            <circle cx="100" cy="115" r="80"/>
            <circle cx="100" cy="115" r="100"/>
        </g>

        <!-- Bell body (dome) -->
        <g class="bell-figure">
            <!-- Wooden base plate -->
            <ellipse cx="100" cy="170" rx="62" ry="10" fill="url(#bellBase)"/>
            <rect x="40" y="155" width="120" height="16" rx="4" fill="url(#bellBase)"/>
            <!-- Brass dome -->
            <path d="M40 155 Q40 70 100 65 Q160 70 160 155 Z" fill="url(#bellBody)"/>
            <!-- Highlight sheen -->
            <ellipse cx="78" cy="100" rx="22" ry="32" fill="url(#bellSheen)"/>
            <!-- Plunger handle on top -->
            <rect x="92" y="42" width="16" height="30" rx="4" fill="url(#bellBody)" class="bell-handle"/>
            <ellipse cx="100" cy="42" rx="14" ry="6" fill="#ffd76b" class="bell-cap"/>
            <ellipse cx="100" cy="40" rx="10" ry="3" fill="#fff8dc" opacity="0.8"/>

            <!-- Face — anime eyes + soft smile.
                 Positioned slightly below dome midpoint so it reads as "looking up at you". -->
            <g class="bell-face">
                <!-- Left eye -->
                <ellipse cx="82" cy="120" rx="7" ry="9" fill="#2c3e50"/>
                <ellipse cx="84" cy="117" rx="2.5" ry="3" fill="#fff8dc"/>
                <!-- Right eye -->
                <ellipse cx="118" cy="120" rx="7" ry="9" fill="#2c3e50"/>
                <ellipse cx="120" cy="117" rx="2.5" ry="3" fill="#fff8dc"/>
                <!-- Closed-eye overlays (blink) -->
                <path class="bell-lid bell-lid-left"  d="M75 120 Q82 122 89 120" stroke="#2c3e50" stroke-width="3" fill="none" stroke-linecap="round" opacity="0"/>
                <path class="bell-lid bell-lid-right" d="M111 120 Q118 122 125 120" stroke="#2c3e50" stroke-width="3" fill="none" stroke-linecap="round" opacity="0"/>
                <!-- Smile -->
                <path d="M86 140 Q100 150 114 140" stroke="#2c3e50" stroke-width="3.5" fill="none" stroke-linecap="round"/>
                <!-- Cheeks -->
                <circle cx="74" cy="135" r="5" fill="#ff8a8a" opacity="0.55"/>
                <circle cx="126" cy="135" r="5" fill="#ff8a8a" opacity="0.55"/>
            </g>
        </g>

        <!-- Cheering sparkles -->
        <g class="bell-sparks" fill="#ffd76b" opacity="0">
            <path d="M30 60 l4 -8 l4 8 l8 4 l-8 4 l-4 8 l-4 -8 l-8 -4 z"/>
            <path d="M170 50 l3 -6 l3 6 l6 3 l-6 3 l-3 6 l-3 -6 l-6 -3 z"/>
            <path d="M165 130 l3 -6 l3 6 l6 3 l-6 3 l-3 6 l-3 -6 l-6 -3 z"/>
        </g>
    </svg>
</div>

@code {
    /// <summary>"idle" | "listening" | "thinking" | "cheering".</summary>
    [Parameter] public string State { get; set; } = "idle";
}
