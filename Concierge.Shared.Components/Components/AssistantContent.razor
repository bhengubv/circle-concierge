@using Concierge.Shared.Diagrams

@if (_segments.Count == 0)
{
    <div class="assistant-markdown">@((MarkupString)RenderMarkdown(Content))</div>
}
else
{
    @foreach (var segment in _segments)
    {
        if (segment.IsMermaid)
        {
            <MermaidBlock Source="@segment.Text" />
        }
        else
        {
            <div class="assistant-markdown">@((MarkupString)RenderMarkdown(segment.Text))</div>
        }
    }
}
