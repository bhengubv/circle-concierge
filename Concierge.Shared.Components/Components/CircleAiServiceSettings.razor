@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (_preferences is not null)
{
    <section class="sheet-group" aria-label="Circle AI service settings">
        <div class="row"><span class="row-name">Circle AI service settings
            <span class="row-sub">For work answered by this Desktop. Changes apply to the next answer.</span>
        </span></div>
        <div class="row">
            <span class="row-name">Stream answers
                <span class="row-sub">Show the answer as it arrives. Off: wait for the complete answer.</span>
            </span>
            <label class="toggle"><input type="checkbox" checked="@_preferences.Current.StreamAnswers"
                @onchange="ChangeStreaming" /><span class="toggle-track" aria-hidden="true"><span class="toggle-knob"></span></span>
                <span class="sr">Stream answers</span></label>
        </div>
        <div class="row">
            <span class="row-name">Agentic work
                <span class="row-sub">Request the service's multi-step assistance. Off: request a conversational answer. Concierge's action approvals still apply separately.</span>
            </span>
            <label class="toggle"><input type="checkbox" checked="@_preferences.Current.AgenticWork"
                @onchange="ChangeAgentic" /><span class="toggle-track" aria-hidden="true"><span class="toggle-knob"></span></span>
                <span class="sr">Agentic work</span></label>
        </div>
        <div class="row"><span class="row-sub" role="status">Both preferences default to On. With this service version, streamed answers are conversational. Multi-step service assistance is not connected yet. Your Agentic work preference is saved, but cannot take effect yet. You can still chat.</span></div>
        @if (_error is not null) { <div class="row" role="alert">@_error</div> }
    </section>
}

@code {
    private CircleAiServicePreferences? _preferences;
    private string? _error;
    protected override void OnInitialized() => _preferences = Services.GetService<CircleAiServicePreferences>();
    private Task ChangeStreaming(ChangeEventArgs e) => Save(current => current with { StreamAnswers = e.Value is true });
    private Task ChangeAgentic(ChangeEventArgs e) => Save(current => current with { AgenticWork = e.Value is true });
    private async Task Save(Func<CircleAiServiceOptions, CircleAiServiceOptions> update)
    {
        try { await _preferences!.UpdateAsync(update); _error = null; }
        catch (Exception) { _error = "Could not save these settings. Your previous choices remain in use."; }
    }
}
