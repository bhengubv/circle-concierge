@inject IJSRuntime JS
@implements IAsyncDisposable

@*
    4-screen first-launch sequence per design spec §8.

    Screen 1 — Welcome.       Bell wakes + "Hi! I'm Bell."
    Screen 2 — Who's using.   Grown-up / Kid / Both.
    Screen 3 — Mic permission. Yes please / Maybe later.
    Screen 4 — Magic moment.  Bell tells a haiku in real time, then cheers.

    Storage: localStorage["concierge-onboarded"] = "1" the moment the user
    completes screen 4 or chooses "Skip" on any screen. Caller mounts
    Onboarding conditionally only when the flag isn't set.

    The whole sequence is autonomous — no parameter for "current step";
    the component drives itself with a state machine.
*@

@if (_visible)
{
    <div class="onboarding-stage" role="dialog" aria-modal="true" aria-label="Welcome to Concierge">
        <div class="onboarding-skip">
            <button type="button" class="page-button quiet" @onclick="SkipAll">Skip the tour</button>
        </div>

        <div class="onboarding-step onboarding-step-@_step">
            @switch (_step)
            {
                case 1: @StepWelcome();    break;
                case 2: @StepWhoUses();    break;
                case 3: @StepMic();        break;
                case 4: @StepMagic();      break;
            }
        </div>

        <div class="onboarding-progress" aria-hidden="true">
            @for (var i = 1; i <= 4; i++)
            {
                var n = i;
                <span class="onboarding-dot @(n <= _step ? "is-on" : null)"></span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnComplete { get; set; }

    private bool _visible = true;
    private int _step = 1;
    private string _mode = "grownup";
    private string _haiku = string.Empty;
    private string _bellState = "sleeping";

    private RenderFragment StepWelcome() => __builder =>
    {
        <div class="onboarding-mascot"><Bell State="@_bellState" /></div>
        <h1 class="onboarding-title">Hi! I'm Bell.</h1>
        <p class="onboarding-lede">
            I'm here to help you do things with AI — write, plan, draw, learn — without the headache.
        </p>
        <button type="button" class="page-cta" @onclick="@(() => Advance(2))">Hello, Bell</button>
    };

    private RenderFragment StepWhoUses() => __builder =>
    {
        <div class="onboarding-mascot"><Bell State="idle" /></div>
        <h1 class="onboarding-title">Quick — who'll mostly use this?</h1>
        <p class="onboarding-lede">I'll match my tone. You can change this any time from the menu.</p>
        <div class="mode-grid">
            <button class="mode-card @(_mode == "grownup" ? "is-active" : null)" type="button" @onclick="@(() => Choose("grownup"))">
                <strong>A grown-up</strong>
                <span class="mode-blurb">Talk to me like a friendly colleague.</span>
            </button>
            <button class="mode-card @(_mode == "kid" ? "is-active" : null)" type="button" @onclick="@(() => Choose("kid"))">
                <strong>A kid</strong>
                <span class="mode-blurb">Simpler words, safer topics, kinder Bell.</span>
            </button>
            <button class="mode-card @(_mode == "both" ? "is-active" : null)" type="button" @onclick="@(() => Choose("both"))">
                <strong>Both of us</strong>
                <span class="mode-blurb">Bell will ask at the start of each chat.</span>
            </button>
        </div>
        <button type="button" class="page-cta" @onclick="@(() => Advance(3))">Next</button>
    };

    private RenderFragment StepMic() => __builder =>
    {
        <div class="onboarding-mascot"><Bell State="listening" /></div>
        <h1 class="onboarding-title">Can I have permission for the mic?</h1>
        <p class="onboarding-lede">I only listen while you hold the Talk button. You're in control.</p>
        <div class="onboarding-actions">
            <button type="button" class="page-cta" @onclick="GrantMic">Yes, of course</button>
            <button type="button" class="page-button quiet" @onclick="@(() => Advance(4))">Maybe later</button>
        </div>
    };

    private RenderFragment StepMagic() => __builder =>
    {
        <div class="onboarding-mascot"><Bell State="@_bellState" /></div>
        <h1 class="onboarding-title">Here's a tiny example.</h1>
        <p class="onboarding-lede">I just wrote you a haiku:</p>
        <pre class="onboarding-haiku">@_haiku</pre>
        <button type="button" class="page-cta" @onclick="Finish">My turn</button>
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Bell wakes 600ms after the welcome lands — feels like he was
            // waiting for you to arrive.
            await Task.Delay(600);
            _bellState = "idle";
            StateHasChanged();
        }
    }

    private async Task Advance(int next)
    {
        _step = next;
        if (next == 4)
        {
            _bellState = "thinking";
            await TypeHaikuAsync();
            _bellState = "cheering";
            try { await JS.InvokeVoidAsync("conciergeSense.playPop"); } catch { }
            try { await JS.InvokeVoidAsync("conciergeSense.hapticSuccess"); } catch { }
        }
        else
        {
            try { await JS.InvokeVoidAsync("conciergeSense.hapticTapLight"); } catch { }
        }
    }

    private async Task Choose(string mode)
    {
        _mode = mode;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "concierge-mode", mode); } catch { }
        try { await JS.InvokeVoidAsync("conciergeSense.hapticTapLight"); } catch { }
    }

    private async Task GrantMic()
    {
        // We request the permission via getUserMedia even though we don't
        // record — this is what triggers the OS prompt. We close the track
        // immediately so the mic light goes off.
        try { await JS.InvokeVoidAsync("conciergeSense.playTing"); } catch { }
        try
        {
            await JS.InvokeVoidAsync("eval", """
                (async () => {
                    try {
                        const s = await navigator.mediaDevices.getUserMedia({ audio: true });
                        s.getTracks().forEach(t => t.stop());
                    } catch (_) { /* user said no — that's fine */ }
                })()
                """);
        }
        catch { }
        await Advance(4);
    }

    private async Task TypeHaikuAsync()
    {
        const string full = "Morning fog parts wide —\nyour question finds a steady hand,\nthe answer arrives.";
        var sb = new System.Text.StringBuilder();
        foreach (var ch in full)
        {
            sb.Append(ch);
            _haiku = sb.ToString();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(ch == '\n' ? 220 : 35);
        }
    }

    private async Task SkipAll()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", "concierge-onboarded", "1"); } catch { }
        _visible = false;
        await OnComplete.InvokeAsync();
    }

    private async Task Finish()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", "concierge-onboarded", "1"); } catch { }
        _visible = false;
        await OnComplete.InvokeAsync();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
