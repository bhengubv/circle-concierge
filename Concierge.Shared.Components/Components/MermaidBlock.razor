@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    A diagram the assistant drew.

    The host div is filled by concierge-mermaid.js after the first render — the
    module is imported lazily, so a conversation that never contains a diagram
    never loads mermaid at all.

    The source sits behind a disclosure using the same quiet chip the tool calls
    use, because it is the same kind of thing: what the machine actually wrote,
    available when you want it and out of the way when you do not.
*@

<div class="diagram">
    <div id="@_hostId" class="diagram-host" aria-label="Diagram"></div>

    <details class="diagram-source">
        <summary class="chip">
            <svg class="chip-bolt" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>
            </svg>
            <span class="chip-what">Diagram source</span>
        </summary>
        <pre class="chip-out">@Source</pre>
    </details>
</div>
