@inject NavigationManager Nav
@implements IDisposable

@*
    AppMenu — the discovery surface. Hidden behind a single ⋯ trigger in the
    top-right corner so the home stays clean, but ALWAYS one tap away.
    Closes when: backdrop is tapped, an item is chosen, Esc is pressed, or
    the URL changes.

    Layout: drops down beneath the trigger (anchored right). On phones the
    panel uses 92vw max so it never clips at the edge.
*@

<div class="appmenu @(_open ? "is-open" : null)">
    <button class="appmenu-trigger"
            type="button"
            @onclick="Toggle"
            aria-label="@(_open ? "Close menu" : "Open menu")"
            aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="6"  r="1.5" fill="currentColor"/>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="12" cy="18" r="1.5" fill="currentColor"/>
        </svg>
    </button>

    @if (_open)
    {
        <div class="appmenu-backdrop" @onclick="Close" @onclick:stopPropagation aria-hidden="true"></div>
        <nav class="appmenu-panel" role="menu" aria-label="Main menu">
            @foreach (var item in _items)
            {
                var i = item;
                <a class="appmenu-item"
                   role="menuitem"
                   href="@i.Href"
                   @onclick="Close"
                   @onclick:preventDefault="false">
                    <span class="appmenu-glyph">
                        @((MarkupString)i.IconSvg)
                    </span>
                    <span class="appmenu-text">
                        <strong>@i.Title</strong>
                        <small>@i.Sub</small>
                    </span>
                </a>
            }
            <div class="appmenu-foot">
                <span class="appmenu-brand-dot" aria-hidden="true"></span>
                <span>Concierge · v1</span>
            </div>
        </nav>
    }
</div>

@code {
    private bool _open;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnNavigated;
    }

    public void Dispose() => Nav.LocationChanged -= OnNavigated;

    private void OnNavigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_open)
        {
            _open = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void Toggle() => _open = !_open;
    private void Close() => _open = false;

    private sealed record Item(string Title, string Sub, string Href, string IconSvg);

    /// <summary>
    /// Menu inventory — every "where do I go from here?" lives here. Routes
    /// not yet built fall through to the existing pages (Settings, Chat,
    /// Skills exist; Help / About / History / Switch are stubs that the
    /// onboarding sequence will own).
    /// </summary>
    private readonly Item[] _items =
    {
        new("New conversation", "Talk to Bell about something new",
            "/chat",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-4-1L3 21l1-5a9 9 0 1 1 17-4z"/><line x1="9"  y1="12" x2="15" y2="12"/><line x1="12" y1="9"  x2="12" y2="15"/></svg>"""),

        new("History", "Past chats and saved results",
            "/history",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>"""),

        new("Skills", "Browse what Bell can do",
            "/skills",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 5.4L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-1.6z"/></svg>"""),

        new("Settings", "Voice, providers, theme",
            "/settings",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.4 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.4l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.6 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>"""),

        new("Switch mode", "Adult / Kid / Both",
            "/switch-mode",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8"  cy="12" r="5"/><circle cx="16" cy="12" r="5"/></svg>"""),

        new("Help", "A quick tour with Bell",
            "/help",
            """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 1 1 5.8 1c0 2-3 2-3 4"/><circle cx="12" cy="17" r="0.6" fill="currentColor"/></svg>"""),

        new("About", "What this is and who made it",
