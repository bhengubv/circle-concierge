@using Concierge.Shared.Tools
@implements IDisposable
@inject IToolApprovalService Approval

@*
    Permission, asked inside the conversation.

    This was a modal sheet over the whole window. That is the wrong shape for
    it: a run stops in the middle of doing something, and covering the work to
    ask about it hides the very context the answer depends on. Codex asks in
    the thread, where the run stopped, and the conversation simply waits.

    So this renders as the last thing in the stream — after what the assistant
    said, before the composer. Answer it and the run continues from there.
*@

@if (_pending.Count > 0)
{
    var ask = _pending[0];

    <section class="ask" role="group" aria-label="Waiting for your permission">
        <div class="ask-head">
            <span class="dot @RiskDot(ask.Request.Risk)" aria-hidden="true"></span>
            <strong>@ask.Request.Summary</strong>
        </div>

        <div class="ask-what">
            <span class="ask-what-label">@ask.Request.ToolName</span>
            @if (!string.IsNullOrWhiteSpace(ask.Request.Detail))
            {
                @* The evidence the decision rests on — a diff for a write, the
                   command line for a run. Machine text, so monospace. *@
                <pre class="chip-out" style="margin:0;">@ask.Request.Detail</pre>
            }
            else
            {
                <span>Nothing further to show.</span>
            }
        </div>

        <div class="ask-actions">
            @* type=button with both handlers: MAUI's BlazorWebView drops
               touch-originated clicks on buttons intermittently. *@
            <button class="btn btn-primary" type="button"
                    @onclick="@(() => Answer(ask.Id, ToolApprovalDecision.Allowed))"
                    @onpointerup="@(() => Answer(ask.Id, ToolApprovalDecision.Allowed))">Allow once</button>
            <button class="btn" type="button"
                    @onclick="@(() => Answer(ask.Id, ToolApprovalDecision.Denied))"
                    @onpointerup="@(() => Answer(ask.Id, ToolApprovalDecision.Denied))">Deny</button>
            @if (_pending.Count > 1)
            {
                <span class="state" style="margin-left:auto;">@(_pending.Count - 1) more after this</span>
            }
        </div>
    </section>
}

@code {
    /// <summary>Risk is a dot and a word — the whole status vocabulary here.
    /// Nothing fills a surface with colour.</summary>
    private static string RiskDot(object? risk) => (risk?.ToString() ?? string.Empty).ToLowerInvariant() switch
    {
        "high" or "critical" => "dot-danger",
        "medium" => "dot-waiting",
        "low" => "dot-done",
        _ => "dot-idle",
    };
}
