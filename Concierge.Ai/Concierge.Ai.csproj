<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Concierge bridge for the CircleAI on-device runtime. Implements ILlmRuntimeService on top of CircleAI.Core.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Concierge.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(CircleAiSourceRoot)' == ''">
    <PackageReference Include="CircleAI" Version="$(CircleAiPackageVersion)" />
  </ItemGroup>

  <!-- Optional source integration for local end-to-end verification. Normal builds
       continue consuming the published Circle AI packages above. -->
  <ItemGroup Condition="'$(CircleAiSourceRoot)' != ''">
    <ProjectReference Include="$(CircleAiSourceRoot)\src\CircleAI.Inference\CircleAI.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
