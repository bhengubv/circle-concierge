<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CollectCoverage>false</CollectCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
    <ProjectReference Include="..\Concierge.Tests.ProcessHost\Concierge.Tests.ProcessHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyAwayLedgerProcessHost" AfterTargets="Build">
    <ItemGroup>
      <_AwayLedgerProcessHostFiles Include="$(MSBuildProjectDirectory)\..\Concierge.Tests.ProcessHost\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AwayLedgerProcessHostFiles)"
          DestinationFolder="$(TargetDir)process-host\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
