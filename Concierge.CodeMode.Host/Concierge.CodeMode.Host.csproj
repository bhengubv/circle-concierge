<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Concierge.CodeMode.Host</AssemblyName>
    <RootNamespace>Concierge.CodeMode.Host</RootNamespace>
    <Description>
      Runs one model-written program, in its own process, and calls back to the parent for
      every tool the program uses.

      A separate process because an in-process script cannot be stopped: a CancellationToken
      is only observed at await points, so a tight loop with none runs until the machine is
      restarted. A child can be killed.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Concierge.Shared\Concierge.Shared.csproj" />
  </ItemGroup>

</Project>
