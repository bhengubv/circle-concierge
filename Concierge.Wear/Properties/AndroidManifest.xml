<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

	<!-- A watch application, and a standalone one: it does not require a
	     paired phone to be useful, because the decision it exists to take is
	     already on the wrist. -->
	<uses-feature android:name="android.hardware.type.watch" />
	<uses-permission android:name="android.permission.RECORD_AUDIO" />

	<!-- The watch has to reach the machine that does the making. Without this it is a
	     dictaphone: it hears you, draws it on the face, and the words go nowhere. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Light and motion need no permission on Android, and neither is asked for here.
	     BODY_SENSORS would be needed for heart rate and is deliberately absent: nothing
	     reads it yet, and a permission requested before it is used is one nobody can
	     judge when the dialog appears. -->

	<!--
	     Cleartext, deliberately, and this was found the hard way.

	     Android has refused cleartext HTTP by default since API 28, silently — no exception,
	     no log line, the request simply never leaves. So every away request this watch made
	     was dropped before it reached the network, and the face looked exactly the same as it
	     does when nothing is running at home. Which is the defect this product exists to
	     remove, hiding inside a platform default.

	     It is http because the desk is on the same network and a self-signed certificate on a
	     192dp face is a dialog nobody can read. What guards it is the key, not the transport,
	     and that decision is written down beside the beacon.
	-->
	<application android:label="Concierge" android:allowBackup="false" android:supportsRtl="true"
	             android:usesCleartextTraffic="true">
		<meta-data android:name="com.google.android.wearable.standalone" android:value="true" />
	</application>
</manifest>
